---
import ImageBandShade from "./ImageBandShade.astro";
import { Image } from "astro:assets";
import classroom from "../assets/images/propuesta_academica/infraestructura_y_vida_bbs/instalaciones/aula_primaria.png";

interface Props { lang?: "es" | "en" }
const { lang = "es" } = Astro.props;
const copy = {
  es: {
    historyTitle: ["Nuestra Historia y", "Propósito"],
    historyParagraphs: [
      "Boston Bilingual School es una institución educativa privada bilingüe preuniversitaria ubicada en una de las mejores zonas de Trujillo. Desde 1990, estamos comprometidos con la excelencia en educación.",
      "Nuestra infraestructura cumple las Condiciones Básicas de Calidad del Ministerio de Educación (MINEDU). Somos una institución inclusiva, no confesional y respetuosa de todas las creencias.",
    ],
    historyIdentityBefore: "Nuestra identidad se define por una", historyIdentityStrong: "Visión de Ciudadanía Global", historyIdentityAfter: ": un modelo educativo interdisciplinario que integra los Temas Centrales de la UNESCO y los Objetivos de Desarrollo Sostenible (ODS).",
    classroomAlt: "Aula de primaria de Boston Bilingual School", noteStrong: "Un entorno de", noteText: "aprendizaje moderno para una formación global y con valores.",
    missionVisionLabel: "Misión y visión", missionTitle: "Misión", missionText: "Somos una Institución Educativa Privada que atiende los niveles de Primaria y Secundaria. Desarrollamos competencias centradas en los enfoques transversales del Currículo Nacional, formando estudiantes listos para ser ciudadanos globales a través de una educación con estándares nacionales e internacionales.",
    visionTitle: "Visión", visionText: "Para el 2030, Boston Bilingual School será reconocido como el colegio líder en Trujillo, distinguido por formar ciudadanos globales con dominio y certificación internacional en inglés y francés, y por preparar para el ingreso a destacadas universidades nacionales e internacionales.",
    diversityAlt: "Grupo de estudiantes con uniformes escolares y banderas internacionales", diversityTitle: ["Diversidad cultural", "para un futuro sin fronteras"],
    philosophyTitle: ["Filosofía Institucional y", "Modelo Pedagógico"], philosophyIntro: "En Boston Bilingual School creemos en una educación que transforma. Nuestro enfoque pedagógico se centra en el desarrollo de competencias y guía cada etapa de la formación de nuestros estudiantes.",
    principles: [
      { title: "Apertura al mundo y a una formación global", description: "Formamos estudiantes con perspectiva internacional y competencias para un mundo sin fronteras." },
      { title: "Formación en valores para una sociedad mejor", description: "Promovemos el respeto, la empatía, la responsabilidad y la honestidad como base para una convivencia positiva y un impacto real en la comunidad." },
      { title: "Fomento de la creatividad y el talento", description: "Impulsamos el pensamiento crítico, la innovación y el desarrollo de múltiples inteligencias." },
      { title: "Excelencia integral", description: "Trabajamos para que cada estudiante alcance su máximo potencial académico, personal y social." },
    ],
    teamTitle: ["Equipo Directivo y", "Docente"], teamIntro: "Un equipo de líderes y educadores comprometidos con la formación de ciudadanos globales.",
    teamRoles: ["Director General", "Subdirector Académico", "Coordinador Primaria", "Coordinador Secundaria", "Coordinador Bilingüismo", "Coordinador Robótica"],
    portraitOf: "Retrato de", portraitPendingOf: "Retrato pendiente de", photoPending: "FOTO PENDIENTE",
  },
  en: {
    historyTitle: ["Our History and", "Purpose"],
    historyParagraphs: [
      "Boston Bilingual School is a private bilingual school with a pre-university focus, located in one of Trujillo's best areas. Since 1990, we have been committed to educational excellence.",
      "Our facilities meet the Basic Quality Conditions established by Peru's Ministry of Education (MINEDU). We are an inclusive, non-denominational school that respects all beliefs.",
    ],
    historyIdentityBefore: "Our identity is defined by a", historyIdentityStrong: "Vision of Global Citizenship", historyIdentityAfter: ": an interdisciplinary educational model that incorporates UNESCO's central themes and the Sustainable Development Goals (SDGs).",
    classroomAlt: "Boston Bilingual School primary classroom", noteStrong: "A modern", noteText: "learning environment for a global education grounded in values.",
    missionVisionLabel: "Mission and vision", missionTitle: "Mission", missionText: "We are a private educational institution serving primary and secondary students. We develop competencies based on the cross-cutting approaches of the National Curriculum, preparing students to become global citizens through education aligned with national and international standards.",
    visionTitle: "Vision", visionText: "By 2030, Boston Bilingual School will be recognized as Trujillo's leading school, known for developing global citizens with internationally certified proficiency in English and French and preparing them for admission to outstanding national and international universities.",
    diversityAlt: "Students in school uniforms holding international flags", diversityTitle: ["Cultural diversity", "for a future without borders"],
    philosophyTitle: ["Institutional Philosophy and", "Educational Model"], philosophyIntro: "At Boston Bilingual School, we believe education transforms lives. Our educational approach focuses on developing competencies and guides every stage of our students' learning.",
    principles: [
      { title: "Openness to the world and global learning", description: "We prepare students with an international outlook and the skills to thrive in a world without borders." },
      { title: "Values for a better society", description: "We promote respect, empathy, responsibility and honesty as the foundation for positive relationships and a meaningful impact on the community." },
      { title: "Creativity and talent", description: "We encourage critical thinking, innovation and the development of diverse abilities." },
      { title: "Well-rounded excellence", description: "We help every student reach their full academic, personal and social potential." },
    ],
    teamTitle: ["Leadership and", "Teaching Team"], teamIntro: "Leaders and educators committed to developing global citizens.",
    teamRoles: ["General Director", "Academic Deputy Director", "Primary Coordinator", "Secondary Coordinator", "Bilingualism Coordinator", "Robotics Coordinator"],
    portraitOf: "Portrait of", portraitPendingOf: "Portrait pending for", photoPending: "PHOTO PENDING",
  },
} as const;
const t = copy[lang];
const principles = t.principles.map((item, i) => ({ ...item, number: `0${i + 1}`, icon: ["globe", "values", "idea", "school"][i] }));

// Retratos pendientes de verificación. Cada ficha tiene su ruta final reservada.
const team = [
  { name: "Dr. Carlos Mendoza", photo: null as string | null, expectedPhoto: "/images/equipo/director-general.webp" },
  { name: "Mg. Patricia Rodríguez", photo: null as string | null, expectedPhoto: "/images/equipo/subdirector-academico.webp" },
  { name: "Lic. Jorge Hernández", photo: null as string | null, expectedPhoto: "/images/equipo/coordinador-primaria.webp" },
  { name: "Mg. María González", photo: null as string | null, expectedPhoto: "/images/equipo/coordinador-secundaria.webp" },
  { name: "Prof. David Torres", photo: null as string | null, expectedPhoto: "/images/equipo/coordinador-bilinguismo.webp" },
  { name: "Ing. Lucas Martínez", photo: null as string | null, expectedPhoto: "/images/equipo/coordinador-robotica.webp" },
];
---

<div class="about-body">
  <section id="historia" class="history" aria-labelledby="history-title">
    <div class="about-wrap history__layout">
      <div class="history__copy">
        <h2 id="history-title">{t.historyTitle[0]}<br /><span>{t.historyTitle[1]}</span></h2>
        <div class="orange-rule" aria-hidden="true"></div>
        <p>{t.historyParagraphs[0]}</p>
        <p>{t.historyParagraphs[1]}</p>
        <p>{t.historyIdentityBefore} <strong>{t.historyIdentityStrong}</strong>{t.historyIdentityAfter}</p>
      </div>
      <div class="history__visual">
        <div class="history__backdrop" aria-hidden="true"></div>
        <div class="history__dots" aria-hidden="true"></div>
        <Image class="history__image" src={classroom} alt={t.classroomAlt} widths={[560, 960, 1280]} sizes="(max-width: 800px) 100vw, 50vw" loading="lazy" />
        <div class="history__note">
          <span class="history__note-icon" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none"><path d="m3 14 15-7 15 7-15 7L3 14Z"/><path d="M10 18v7c4.6 3.7 11.4 3.7 16 0v-7M32 15v9"/></svg>
          </span>
          <p><strong>{t.noteStrong}</strong><br />{t.noteText}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mission-vision" aria-label={t.missionVisionLabel}>
    <div class="about-wrap mission-vision__grid">
      <article class="mission-card mission-card--mission">
        <div class="mission-card__top"><span class="mission-card__letter">M</span><span class="mission-card__icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="12"/><circle cx="20" cy="20" r="6"/><circle cx="20" cy="20" r="1.5" fill="currentColor" stroke="none"/><path d="m20 20 14-14m-7 0h7v7"/></svg></span></div>
        <h2>{t.missionTitle}</h2>
        <p>{t.missionText}</p>
      </article>
      <article class="mission-card mission-card--vision">
        <div class="mission-card__top"><span class="mission-card__letter">V</span><span class="mission-card__icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><path d="M3 20s6-10 17-10 17 10 17 10-6 10-17 10S3 20 3 20Z"/><circle cx="20" cy="20" r="5"/></svg></span></div>
        <h2>{t.visionTitle}</h2>
        <p>{t.visionText}</p>
      </article>
    </div>
  </section>

  <section class="diversity" aria-labelledby="diversity-title">
    <img src="/images/nosotros/diversidad-cultural.webp" alt={t.diversityAlt} width="1920" height="686" loading="lazy" decoding="async" />
    <ImageBandShade mobile="side" />
    <div class="about-wrap diversity__content">
      <p class="diversity__eyebrow">Boston Bilingual School</p>
      <h2 id="diversity-title">{t.diversityTitle[0]}<br />{t.diversityTitle[1]}</h2>
      <div class="orange-rule" aria-hidden="true"></div>
    </div>
  </section>

  <section class="philosophy" aria-labelledby="philosophy-title">
    <div class="about-wrap">
      <div class="philosophy__heading">
        <h2 id="philosophy-title">{t.philosophyTitle[0]} <span>{t.philosophyTitle[1]}</span></h2>
        <p>{t.philosophyIntro}</p>
      </div>
      <div class="philosophy__grid">
        {principles.map((principle) => (
          <article class="principle-card">
            <span class="principle-card__number">{principle.number}</span>
            <span class="principle-card__icon" aria-hidden="true">
              {principle.icon === "globe" && <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="14"/><path d="M6 20h28M20 6c5 4 7 9 7 14s-2 10-7 14M20 6c-5 4-7 9-7 14s2 10 7 14"/></svg>}
              {principle.icon === "values" && <svg viewBox="0 0 40 40" fill="none"><path d="M7 9h26v20H20l-7 5v-5H7V9Z"/><path d="m14 20 4 4 8-9"/></svg>}
              {principle.icon === "idea" && <svg viewBox="0 0 40 40" fill="none"><path d="M13 26c-3-2-5-6-5-10a12 12 0 0 1 24 0c0 4-2 8-5 10l-2 5H15l-2-5ZM16 35h8M20 3V1M5 7 3 5m32 2 2-2"/></svg>}
              {principle.icon === "school" && <svg viewBox="0 0 40 40" fill="none"><path d="M5 34V18l15-12 15 12v16H5ZM13 34V22h14v12M17 22v12M23 22v12M8 17l12 9 12-9"/></svg>}
            </span>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="team" aria-labelledby="team-title">
    <div class="about-wrap">
      <div class="team__heading">
        <div><h2 id="team-title">{t.teamTitle[0]} <span>{t.teamTitle[1]}</span></h2><div class="orange-rule" aria-hidden="true"></div></div>
        <p>{t.teamIntro}</p>
      </div>
      <div class="team__grid">
        {team.map((person, i) => (
          <article class="team-card">
            <div class="team-card__photo" data-portrait-slot={person.expectedPhoto}>
              {person.photo ? <img src={person.photo} alt={`${t.portraitOf} ${person.name}`} width="240" height="240" loading="lazy" /> : <span class="team-card__placeholder" role="img" aria-label={`${t.portraitPendingOf} ${person.name}`}><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="18" r="8"/><path d="M9 43c1-10 7-15 15-15s14 5 15 15"/></svg><small>{t.photoPending}</small></span>}
            </div>
            <div class="team-card__copy"><p>{t.teamRoles[i]}</p><h3>{person.name}</h3></div>
            <span class="team-card__plus" aria-hidden="true">+</span>
          </article>
        ))}
      </div>
    </div>
  </section>
</div>

<style>
  .about-body{--about-blue:#073b79;--about-orange:#ff8a00;background:#fff;color:#333;overflow:hidden}
  .about-wrap{width:min(100% - 64px,1200px);margin-inline:auto}
  .about-body h2,.about-body h3,.about-body p{margin-top:0}
  .about-body h2{color:var(--about-blue);font-family:var(--font-heading);font-weight:800;letter-spacing:-.045em;line-height:1.09}
  .about-body h2 span{color:var(--about-orange)}
  .orange-rule{width:62px;height:4px;border-radius:4px;background:var(--about-orange)}

  .history{padding:82px 0 38px}
  .history__layout{display:grid;grid-template-columns:.96fr 1.04fr;gap:82px;align-items:center}
  .history__copy{max-width:520px}
  .history h2{font-size:clamp(2.55rem,3.35vw,3.45rem);margin-bottom:21px}
  .history__copy .orange-rule{margin-bottom:31px}
  .history__copy p{font-size:1.04rem;line-height:1.78;color:#454b55;margin-bottom:20px}
  .history__copy p:last-child{margin-bottom:0}
  .history__copy strong{color:var(--about-blue)}
  .history__visual{position:relative;min-height:510px;padding:30px 0 22px 24px;isolation:isolate}
  .history__backdrop{position:absolute;inset:8px 2px 5px 12px;z-index:-1;border-radius:60px 42px 65px 50px;background:radial-gradient(ellipse 30% 55% at 12% 48%,#ffad35 0 98%,transparent 100%),radial-gradient(ellipse 60% 65% at 84% 40%,#cbe3ff 0 98%,transparent 100%)}
  .history__dots{position:absolute;right:-14px;top:-7px;width:126px;height:100px;background-image:radial-gradient(#ff8a00 2px,transparent 2px);background-size:20px 20px;z-index:2}
  .history__image{display:block;width:100%;height:458px;object-fit:cover;object-position:center;border-radius:55px 48px 50px 48px;box-shadow:0 16px 28px rgba(5,56,116,.12)}
  .history__note{position:absolute;left:-18px;bottom:-7px;display:flex;align-items:center;gap:18px;width:348px;min-height:96px;padding:15px 23px;border-radius:24px;background:#fff;box-shadow:0 16px 34px rgba(5,51,102,.11)}
  .history__note-icon{flex:none;display:grid;place-items:center;width:68px;height:68px;border-radius:50%;background:#ff8a00;color:#fff}
  .history__note-icon svg{width:39px;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .history__note p{margin:0;font-size:.9rem;line-height:1.42;color:#46505c}
  .history__note strong{color:var(--about-blue)}

  .mission-vision{padding:34px 0 42px}
  .mission-vision__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}
  .mission-card{min-height:358px;padding:35px 43px 38px;border-radius:36px;box-shadow:0 12px 30px rgba(9,68,124,.045)}
  .mission-card--mission{background:linear-gradient(126deg,#fff8ee,#fffdfa)}
  .mission-card--vision{background:linear-gradient(126deg,#edf6ff,#f9fcff)}
  .mission-card__top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:3px}
  .mission-card__letter{display:grid;place-items:center;width:72px;height:72px;border-radius:24px;background:rgba(255,146,0,.065);color:var(--about-orange);font-family:var(--font-heading);font-size:3.2rem;font-weight:800;line-height:1}
  .mission-card__icon{display:grid;place-items:center;width:76px;height:76px;border-radius:50%;background:#fff;color:var(--about-orange)}
  .mission-card--vision .mission-card__icon{color:#227ce8}
  .mission-card__icon svg{width:42px;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .mission-card h2{font-size:2rem;margin-bottom:17px}
  .mission-card p{max-width:58ch;margin-bottom:0;font-size:1.02rem;line-height:1.72;color:#58616b}

  .diversity{position:relative;min-height:388px;display:flex;align-items:center;isolation:isolate;overflow:hidden;color:white}
  .diversity :global(img){position:absolute;inset:0;z-index:-3;width:100%;height:100%;object-fit:cover;object-position:center 48%}
  .diversity__content{padding-block:68px}
  .diversity__eyebrow{font-family:var(--font-accent);font-size:.86rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;margin-bottom:21px}
  .diversity h2{max-width:700px;color:white;font-size:clamp(2.2rem,3.2vw,3.4rem);margin-bottom:19px}

  .philosophy{position:relative;padding:65px 0 60px;background:linear-gradient(180deg,#fff 0%,#f8fbff 65%,#fff 100%)}
  .philosophy__heading{text-align:center;margin:0 auto 34px}
  .philosophy h2{font-size:clamp(2.1rem,3vw,3.2rem);margin-bottom:14px}
  .philosophy__heading p{max-width:950px;margin:0 auto;color:#505963;font-size:1.02rem;line-height:1.65}
  .philosophy__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 32px}
  .principle-card{position:relative;min-height:237px;padding:27px 38px 29px;border-left:4px solid var(--about-orange);border-radius:20px;background:#fff;box-shadow:0 10px 25px rgba(18,73,133,.075)}
  .principle-card__number{display:block;margin-bottom:8px;color:var(--about-orange);font-family:var(--font-heading);font-size:3.3rem;font-weight:800;letter-spacing:-.06em;line-height:1}
  .principle-card__icon{position:absolute;right:27px;top:25px;width:72px;height:72px;display:grid;place-items:center;border-radius:50%;background:#fff7ec;color:var(--about-orange)}
  .principle-card__icon svg{width:36px;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .principle-card h3{max-width:480px;margin:0 0 6px;color:var(--about-blue);font-size:1.11rem;font-weight:800;line-height:1.25;letter-spacing:-.03em}
  .principle-card p{max-width:490px;margin:0;color:#58616b;font-size:.99rem;line-height:1.55}

  .team{padding:45px 0 85px;background:#fff}
  .team__heading{display:flex;align-items:center;justify-content:space-between;gap:38px;margin-bottom:37px}
  .team h2{font-size:clamp(2.15rem,3vw,3.25rem);margin-bottom:17px}
  .team__heading p{max-width:395px;margin:0;color:#5b6470;font-size:1rem;line-height:1.55}
  .team__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px 26px}
  .team-card{position:relative;display:flex;align-items:center;min-width:0;min-height:125px;padding:15px 39px 15px 113px;border-radius:24px;background:#fff;box-shadow:0 9px 26px rgba(6,54,108,.09)}
  .team-card__photo{position:absolute;left:9px;top:50%;width:96px;height:96px;border-radius:50%;overflow:hidden;transform:translateY(-50%);background:#e6f2ff;box-shadow:inset 0 -7px #ff9200}
  .team-card__photo :global(img){display:block;width:100%;height:100%;object-fit:cover}
  .team-card__placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;gap:1px;color:#557eae;background:linear-gradient(140deg,#eff6ff,#e1edfb)}
  .team-card__placeholder svg{width:43px;height:43px;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}
  .team-card__placeholder small{font-family:var(--font-accent);font-size:.43rem;font-weight:800;letter-spacing:.02em;line-height:1.1}
  .team-card__copy{min-width:0}
  .team-card__copy p{margin:0 0 5px;color:var(--about-blue);font-size:.68rem;font-weight:800;line-height:1.25;text-transform:uppercase}
  .team-card h3{margin:0;color:var(--about-orange);font-size:1.06rem;font-weight:800;line-height:1.25;letter-spacing:-.03em}
  .team-card__plus{position:absolute;right:14px;bottom:12px;display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#fff;color:var(--about-blue);font-size:1.35rem;font-weight:500;line-height:1;box-shadow:0 2px 9px rgba(5,51,102,.17)}

  @media(max-width:1000px){.history__layout{gap:36px}.history__copy p{font-size:.96rem}.history__visual{min-height:470px}.history__image{height:425px}.team__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:800px){.history{padding-top:62px}.history__layout{grid-template-columns:1fr;gap:30px}.history__copy{max-width:740px}.history__visual{width:min(100%,690px);margin:auto}.mission-vision__grid{grid-template-columns:1fr;gap:20px}.mission-card{padding:28px;min-height:0}.philosophy__grid{gap:20px}.principle-card{padding:24px;min-height:255px}.team__heading{align-items:flex-start;flex-direction:column;gap:10px}}
  @media(max-width:640px){.about-wrap{width:min(100% - 36px,1200px)}.history{padding:52px 0 30px}.history h2{font-size:2.45rem}.history__copy p{font-size:.96rem;line-height:1.7}.history__visual{min-height:360px;padding:14px 0 16px 12px}.history__image{height:340px;border-radius:33px}.history__note{left:-3px;bottom:-10px;width:min(315px,88%);min-height:78px;padding:10px 13px;gap:10px;border-radius:16px}.history__note-icon{width:48px;height:48px}.history__note-icon svg{width:31px}.history__note p{font-size:.78rem}.history__dots{right:-8px;top:-13px;width:86px;height:80px;background-size:15px 15px}.mission-vision{padding:36px 0}.mission-vision__grid{grid-template-columns:1fr;gap:18px}.mission-card{min-height:0;padding:26px 28px 32px;border-radius:26px}.mission-card__letter,.mission-card__icon{width:58px;height:58px}.mission-card__letter{font-size:2.7rem}.mission-card__icon svg{width:34px}.mission-card h2{font-size:1.8rem}.mission-card p{font-size:.95rem}.diversity{min-height:340px}.diversity__eyebrow{font-size:.7rem}.diversity h2{font-size:2.25rem}.philosophy{padding:48px 0}.philosophy h2{font-size:2.15rem}.philosophy__heading p{font-size:.94rem}.philosophy__grid{grid-template-columns:1fr;gap:16px}.principle-card{min-height:210px;padding:25px 25px 25px 29px}.principle-card__number{font-size:2.9rem}.principle-card__icon{width:58px;height:58px;right:18px;top:18px}.principle-card__icon svg{width:30px}.principle-card h3{font-size:1.02rem}.principle-card p{font-size:.92rem}.team{padding:32px 0 64px}.team h2{font-size:2.15rem}.team__heading p{font-size:.94rem}.team__grid{grid-template-columns:1fr;gap:15px}.team-card{min-height:112px;padding-left:110px}.team-card__photo{width:88px;height:88px}}
  @media(max-width:420px){
    .history h2{font-size:clamp(2rem,9vw,2.35rem)}
    .philosophy h2,.team h2{font-size:clamp(1.8rem,8vw,2.1rem)}
    .diversity h2{font-size:clamp(1.9rem,8vw,2.2rem)}
    .history__visual{min-height:335px}
    .history__image{height:315px}
    .team-card{padding-left:104px;padding-right:20px}
  }
</style>
