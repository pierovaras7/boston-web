---
import { getCollection } from 'astro:content';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;

const allArticles = await getCollection('articles');
const filteredArticles = allArticles.filter(article =>
  (article.data.lang || 'es') === lang
);
const sortedArticles = filteredArticles.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const recentArticles = sortedArticles.slice(0, 3);

const translations = {
  es: {
    title: 'Blog / Noticias Destacadas',
    subtitle: 'Articulos educativos y eventos recientes',
    readMore: 'Leer mas',
    seeAll: 'Ver todas las noticias',
  },
  en: {
    title: 'Blog / Highlights',
    subtitle: 'Educational articles and recent events',
    readMore: 'Read more',
    seeAll: 'See all news',
  },
};

const t = translations[lang as keyof typeof translations] || translations.es;

const categoryLabels: Record<string, Record<string, string>> = {
  es: {
    academico: 'Académico',
    concurso: 'Concurso',
    evento: 'Evento',
    educativo: 'Educativo',
  },
  en: {
    academico: 'Academic',
    concurso: 'Contest',
    evento: 'Event',
    educativo: 'Educational',
  },
};
---

<section class="blog-highlights">
  <div class="container">
    <div class="blog-header">
      <h2>{t.title}</h2>
      <p>{t.subtitle}</p>
      <div class="header-divider"></div>
    </div>

    {recentArticles.length > 0 ? (
      <>
        <div class="articles-grid">
          {recentArticles.map((article) => (
            <article class="article-card">
              {article.data.image && (
                <div class="article-image">
                  <img src={article.data.image} alt={article.data.title} />
                </div>
              )}

              <div class="article-content">
                <div class="article-badge" data-category={article.data.category}>
                  {categoryLabels[lang]?.[article.data.category] || article.data.category.charAt(0).toUpperCase() + article.data.category.slice(1)}
                </div>

                <h3 class="article-title">{article.data.title}</h3>

                <p class="article-description">{article.data.description}</p>

                <div class="article-meta">
                  <time datetime={article.data.date.toISOString()}>
                    {new Date(article.data.date).toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  {article.data.author && (
                    <>
                      <span class="separator">•</span>
                      <span class="author">{article.data.author}</span>
                    </>
                  )}
                </div>

                <a href={`/articulos/${article.id}`} class="btn-link">
                  {t.readMore}
                  <span class="arrow">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        {allArticles.length > 3 && (
          <div class="blog-footer">
            <a href="/articulos" class="btn-primary">{t.seeAll}</a>
          </div>
        )}
      </>
    ) : (
      <div class="blog-empty">
        <p>{lang === 'es' ? 'No hay articulos disponibles aun.' : 'No articles available yet.'}</p>
      </div>
    )}
  </div>
</section>

<style>
  .blog-highlights {
    padding: 4rem 0;
    background: linear-gradient(to bottom, #f5f5f5, #ffffff);
  }

  .blog-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .blog-header h2 {
    margin: 0 0 0.5rem 0;
    font-size: 2.5rem;
    color: var(--color-primary);
  }

  .blog-header p {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .header-divider {
    width: 4rem;
    height: 0.25rem;
    background: linear-gradient(to right, var(--color-primary), var(--color-secondary));
    margin: 1rem auto 0;
    border-radius: 2px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .article-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.3s ease;
  }

  .article-card:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    transform: translateY(-4px);
  }

  .article-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background-color: #e0e0e0;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .article-card:hover .article-image img {
    transform: scale(1.05);
  }

  .article-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .article-badge {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    width: fit-content;
  }

  .article-badge[data-category="academico"] {
    background-color: #E3F2FD;
    color: #1976D2;
  }

  .article-badge[data-category="concurso"] {
    background-color: #E8F5E9;
    color: #388E3C;
  }

  .article-badge[data-category="evento"] {
    background-color: #F3E5F5;
    color: #7B1FA2;
  }

  .article-badge[data-category="educativo"] {
    background-color: #FFF3E0;
    color: #F57C00;
  }

  .article-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    color: var(--color-text);
    line-height: 1.3;
  }

  .article-card:hover .article-title {
    color: var(--color-primary);
  }

  .article-description {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0 0 1rem 0;
    line-height: 1.5;
    flex-grow: 1;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .article-meta time {
    font-weight: 500;
  }

  .article-meta .separator {
    margin: 0 0.25rem;
  }

  .article-meta .author {
    font-weight: 500;
  }

  .btn-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.3s ease;
    width: fit-content;
  }

  .btn-link:hover {
    color: var(--color-secondary);
    transform: translateX(4px);
  }

  .btn-link .arrow {
    transition: transform 0.3s ease;
  }

  .btn-link:hover .arrow {
    transform: translateX(4px);
  }

  .blog-footer {
    text-align: center;
    margin-top: 2rem;
  }

  .blog-empty {
    text-align: center;
    padding: 2rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .blog-header h2 {
      font-size: 2rem;
    }

    .articles-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
