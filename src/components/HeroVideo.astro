---
import { getTranslation } from "../i18n/translations";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const t = getTranslation(lang);
---

<section class="hero">
  <video class="hero__video" autoplay muted loop>
    <source src="/videos/recorrido_bbs.mp4" type="video/mp4" />
  </video>

  <div class="hero__overlay"></div>

  <div class="container hero__content">
    <h1 class="hero__tagline">{t.hero.tagline}</h1>
    <p class="hero__subtitle">{t.hero.subtitle}</p>
    <div class="hero__ctas">
      <a href={`/${lang}/admisiones`} class="cta cta--primary">
        {t.hero.cta1}
      </a>
      <a href={`/${lang}/contacto`} class="cta cta--secondary">
        {t.hero.cta2}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 700px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 61, 130, 0.75) 0%, rgba(255, 153, 0, 0.55) 100%);
    z-index: 2;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: white;
    max-width: 800px;
  }

  .hero__tagline {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 900;
    margin: 0 0 1rem 0;
    text-shadow: 3px 3px 8px rgba(0, 0, 0, 0.4);
    line-height: 1.1;
    font-family: var(--font-heading);
    letter-spacing: -1px;
  }

  .hero__subtitle {
    font-size: clamp(1.1rem, 3vw, 1.4rem);
    font-weight: 300;
    margin: 0 0 2rem 0;
    text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.3);
    line-height: 1.6;
    font-family: var(--font-body);
    letter-spacing: 0.5px;
  }

  .hero__ctas {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta {
    display: inline-block;
    padding: 1.2rem 2.5rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.3s ease;
    font-size: 1.05rem;
    font-family: var(--font-accent);
    letter-spacing: 0.5px;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
  }

  .cta--primary {
    background: linear-gradient(135deg, var(--color-accent) 0%, #ff7c00 100%);
    color: white;
    box-shadow: 0 8px 20px rgba(255, 153, 0, 0.3);
  }

  .cta--primary:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(255, 153, 0, 0.4);
  }

  .cta--secondary {
    background: transparent;
    color: white;
    border: 2px solid white;
    box-shadow: 0 4px 15px rgba(255, 255, 255, 0.2);
  }

  .cta--secondary:hover {
    transform: translateY(-6px);
    background: white;
    color: var(--color-primary);
    box-shadow: 0 12px 25px rgba(255, 255, 255, 0.35);
  }

  @media (max-width: 768px) {
    .hero {
      height: 500px;
    }

    .hero__subtitle {
      margin-bottom: 1.5rem;
    }

    .hero__ctas {
      flex-direction: column;
      gap: 1rem;
    }

    .cta {
      width: 100%;
      max-width: 300px;
    }
  }
</style>
