---
type Page = "inicio" | "nosotros" | "primaria" | "secundaria" | "admisiones" | "contacto";
interface Props {
  page: Page;
  lang?: "es" | "en";
}

const { page, lang = "es" } = Astro.props;
const base = `/${lang}`;
const copy = {
  es: {
    inicio: { eyebrow: "Educación bilingüe para un mundo sin fronteras", title: "Formamos ciudadanos", accent: "globales", lead: "Formamos líderes globales con excelencia académica y valores sólidos.", detail: "", primary: "Admisiones 2027", primaryHref: `${base}/admisiones`, secondary: "Conoce nuestra propuesta", secondaryHref: `${base}/#programas` },
    nosotros: { eyebrow: "Boston Bilingual School", title: "Conoce nuestra historia, propósito y", accent: "visión global", lead: "Formamos líderes globales con excelencia académica y valores sólidos.", detail: "", primary: "Conoce nuestra historia", primaryHref: "#historia", secondary: "Agenda una visita", secondaryHref: `${base}/contacto` },
    primaria: { eyebrow: "Educación primaria", title: "Educación", accent: "Primaria", lead: "Formación integral con énfasis en bilingüismo, innovación y desarrollo humano.", detail: "Construimos bases sólidas para formar ciudadanos globales, creativos y con valores.", primary: "Conoce el programa", primaryHref: "#plan-estudios", secondary: "Agenda una visita", secondaryHref: `${base}/contacto` },
    secundaria: { eyebrow: "Formación para grandes metas", title: "Educación", accent: "Secundaria", lead: "Formación preuniversitaria de alto nivel con énfasis en certificación internacional.", detail: "Impulsamos pensamiento crítico, liderazgo y preparación para el futuro universitario.", primary: "Conoce el programa", primaryHref: "#plan-estudios", secondary: "Agenda una visita", secondaryHref: `${base}/contacto` },
    admisiones: { eyebrow: "Proceso de admisión 2027", title: "Admisiones", accent: "2027", lead: "Únete a una comunidad educativa bilingüe, innovadora y comprometida con formar ciudadanos globales.", detail: "Te acompañamos paso a paso para que tu proceso de ingreso sea claro, ágil y cercano.", primary: "Postula ahora", primaryHref: "#postulacion", secondary: "Agenda una visita", secondaryHref: `${base}/contacto` },
    contacto: { eyebrow: "Estamos para ayudarte", title: "Contáctanos", accent: "", lead: "Estamos aquí para resolver tus dudas y acompañarte en lo que necesites.", detail: "Escríbenos, llámanos o agenda una visita. Nuestro equipo te responderá con cercanía y rapidez.", primary: "Enviar mensaje", primaryHref: "#formulario", secondary: "Agenda una visita", secondaryHref: "#formulario" },
  },
  en: {
    inicio: { eyebrow: "Bilingual education without borders", title: "Shaping global", accent: "citizens", lead: "We develop global leaders through academic excellence and strong values.", detail: "", primary: "Admissions 2027", primaryHref: `${base}/admisiones`, secondary: "Explore our approach", secondaryHref: `${base}/#programas` },
    nosotros: { eyebrow: "Boston Bilingual School", title: "Discover our history, purpose and", accent: "global vision", lead: "We develop global leaders through academic excellence and strong values.", detail: "", primary: "Our story", primaryHref: "#historia", secondary: "Schedule a visit", secondaryHref: `${base}/contacto` },
    primaria: { eyebrow: "Primary education", title: "Primary", accent: "Education", lead: "A well-rounded education with a focus on bilingualism, innovation and personal growth.", detail: "Building strong foundations for creative global citizens with values.", primary: "Explore the program", primaryHref: "#plan-estudios", secondary: "Schedule a visit", secondaryHref: `${base}/contacto` },
    secundaria: { eyebrow: "Preparing for big goals", title: "Secondary", accent: "Education", lead: "High-level university preparation with a focus on international certification.", detail: "We nurture critical thinking, leadership and readiness for university.", primary: "Explore the program", primaryHref: "#plan-estudios", secondary: "Schedule a visit", secondaryHref: `${base}/contacto` },
    admisiones: { eyebrow: "Admissions process 2027", title: "Admissions", accent: "2027", lead: "Join an innovative bilingual community committed to developing global citizens.", detail: "We guide your family through every step of a clear, welcoming process.", primary: "Apply now", primaryHref: "#postulacion", secondary: "Schedule a visit", secondaryHref: `${base}/contacto` },
    contacto: { eyebrow: "We're here to help", title: "Contact Us", accent: "", lead: "We're here to answer your questions and support you every step of the way.", detail: "Send us a message, give us a call or schedule a visit. Our team will respond promptly and personally.", primary: "Send a Message", primaryHref: "#formulario", secondary: "Schedule a Visit", secondaryHref: "#formulario" },
  },
} as const;
const content = copy[lang][page];
const backgroundFile = page === "contacto"
  ? "contacto-background-updated.webp"
  : ["inicio", "primaria", "secundaria"].includes(page)
    ? `${page}-background-sharp.webp`
    : `${page}-background.webp`;
const foregroundFile = page === "contacto" ? "contacto-foreground-updated.webp" : `${page}-foreground.webp`;
const backgroundSrc = page === "nosotros" ? "/images/nosotros/campus-boston-hero.webp" : `/images/heroes/${backgroundFile}`;
---

<section class="site-hero" data-page={page} data-lang={lang} aria-labelledby={`${page}-hero-title`}>
  <div class="site-hero__photo">
    <img src={backgroundSrc} alt="" loading="eager" fetchpriority="high" />
  </div>
  <div class="site-hero__shade" aria-hidden="true"></div>
  <div class="site-hero__orb" aria-hidden="true"></div>
  {page !== "nosotros" && <div class="site-hero__foreground" aria-hidden="true">
    <img src={`/images/heroes/${foregroundFile}`} alt="" loading="eager" />
  </div>}
  <div class="container site-hero__inner">
    <div class="site-hero__copy">
      <p class="site-hero__eyebrow">{content.eyebrow}</p>
      <h1 id={`${page}-hero-title`}>{content.title} {content.accent && <span>{content.accent}</span>}</h1>
      <p class="site-hero__lead">{content.lead}</p>
      {content.detail && <p class="site-hero__detail">{content.detail}</p>}
      <div class="site-hero__actions">
        <a class="site-hero__button site-hero__button--primary" href={content.primaryHref}>{content.primary}<span aria-hidden="true">→</span></a>
        <a class="site-hero__button site-hero__button--outline" href={content.secondaryHref}>{page === "contacto" && <svg class="site-hero__calendar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 2v6M17 2v6M3 10h18"/></svg>}{content.secondary}</a>
      </div>
    </div>
  </div>
  <div class="site-hero__orange" aria-hidden="true"></div>
  <div class="site-hero__dots" aria-hidden="true"></div>
  <svg class="site-hero__wave" viewBox="0 0 1440 115" preserveAspectRatio="none" aria-hidden="true">
    <path fill="#a9cefb" d="M0 52C245 10 398 115 675 95c296-21 431-86 765-95v115H0Z" />
    <path fill="#fff" d="M0 78C252 43 391 122 677 108c280-14 485-78 763-72v79H0Z" />
  </svg>
</section>

<style>
  .site-hero{position:relative;isolation:isolate;min-height:570px;display:flex;align-items:center;background:#003d82;color:#fff;overflow:hidden}
  .site-hero__photo{position:absolute;z-index:-3;inset:0;overflow:hidden}
  .site-hero__photo img{width:100%;height:100%;object-fit:cover;object-position:center}
  .site-hero[data-page="nosotros"] .site-hero__photo img{object-position:right center}
  .site-hero__shade{position:absolute;z-index:-2;inset:0 auto 0 0;width:56%;background:#003d82;border-bottom-right-radius:45% 70%}
  .site-hero__orb{position:absolute;z-index:-1;left:-105px;top:-180px;width:360px;height:440px;border-radius:50%;background:rgba(35,124,214,.18)}
  .site-hero__foreground{position:absolute;z-index:0;inset:0;pointer-events:none;overflow:hidden}
  .site-hero__foreground img{width:100%;height:100%;object-fit:cover;object-position:center}
  .site-hero[data-page="nosotros"] .site-hero__foreground{left:31%}
  .site-hero[data-page="contacto"] .site-hero__foreground{left:31%}
  .site-hero[data-page="nosotros"] .site-hero__foreground img,
  .site-hero[data-page="contacto"] .site-hero__foreground img{object-position:25% center}
  .site-hero[data-page="inicio"] .site-hero__foreground img{object-position:center 38%}
  .site-hero[data-page="admisiones"] h1{max-width:none;white-space:nowrap;font-size:clamp(3.2rem,4.6vw,4.25rem)}
  .site-hero[data-page="nosotros"] h1{max-width:16ch;font-size:clamp(2.6rem,4vw,4.15rem)}
  .site-hero[data-page="contacto"] .site-hero__eyebrow{color:#ff9900}
  .site-hero[data-page="contacto"] .site-hero__button--primary{background:#ff9900}
  .site-hero[data-page="contacto"] .site-hero__button--primary:hover{background:#ec8500}
  .site-hero__calendar{width:16px;height:16px;flex:none}
  .site-hero__inner{width:100%;position:relative;z-index:1;padding-top:80px;padding-bottom:115px}
  .site-hero__copy{max-width:570px}
  .site-hero__eyebrow{margin:0 0 14px;font-family:var(--font-accent);font-size:.78rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#dceaff}
  .site-hero__eyebrow::before{content:"";display:inline-block;width:28px;height:3px;margin:0 12px 3px 0;background:var(--color-accent)}
  .site-hero h1{max-width:12ch;margin:0 0 16px;font-size:clamp(2.6rem,4.3vw,4.55rem);font-weight:900;line-height:1.04;letter-spacing:-.045em;text-wrap:balance}
  .site-hero h1 span{color:var(--color-accent)}
  .site-hero__lead{max-width:46ch;margin:0 0 10px;font-size:clamp(1rem,1.4vw,1.3rem);font-weight:600;line-height:1.38}
  .site-hero__detail{max-width:47ch;margin:0;color:#e2edfa;font-size:.98rem;line-height:1.5}
  .site-hero__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
  .site-hero__button{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:12px 20px;border:1px solid #fff;border-radius:6px;font-family:var(--font-accent);font-size:.88rem;font-weight:700;line-height:1.2;text-decoration:none}
  .site-hero__button--primary{border-color:var(--color-accent);background:linear-gradient(120deg,var(--color-accent),#ff8100);box-shadow:0 7px 18px rgba(255,145,0,.2)}
  .site-hero__button:hover{transform:translateY(-2px)}
  .site-hero__button--outline:hover{background:#fff;color:var(--color-primary)}
  .site-hero__orange{position:absolute;z-index:2;right:-83px;bottom:6px;width:210px;height:140px;background:#ff9200;border-radius:100% 0 0 0;transform:rotate(-10deg)}
  .site-hero__dots{position:absolute;z-index:2;right:32px;bottom:34px;width:91px;height:76px;opacity:.8;background-image:radial-gradient(#ff9200 1.5px,transparent 1.5px);background-size:14px 14px}
  .site-hero__wave{position:absolute;z-index:3;right:0;bottom:-1px;left:0;width:100%;height:100px;pointer-events:none}
  @media(min-width:901px){
    .site-hero[data-page="primaria"] .site-hero__foreground img{position:absolute;right:4%;bottom:0;width:auto;max-width:none;height:clamp(330px,30vw,540px);object-fit:contain;object-position:right bottom}
    .site-hero[data-page="inicio"] .site-hero__foreground img,
    .site-hero[data-page="secundaria"] .site-hero__foreground img,
    .site-hero[data-page="admisiones"] .site-hero__foreground img,
    .site-hero[data-page="contacto"] .site-hero__foreground img{position:absolute;bottom:0;width:auto;max-width:none;object-fit:contain;object-position:right bottom}
    .site-hero[data-page="inicio"] .site-hero__foreground img{right:6%;height:clamp(360px,33vw,590px)}
    .site-hero[data-page="secundaria"] .site-hero__foreground img{right:2.5%;height:clamp(360px,33vw,590px)}
    .site-hero[data-page="admisiones"] .site-hero__foreground img{right:3%;height:clamp(340px,32vw,560px)}
    .site-hero[data-page="contacto"] .site-hero__foreground img{right:10%;bottom:0;height:clamp(360px,32vw,570px)}
  }
  @media(max-width:900px){
    .site-hero{min-height:540px}
    .site-hero__shade{width:70%;border-bottom-right-radius:34% 55%}
    .site-hero__copy{max-width:400px}
    .site-hero__inner{padding-top:65px}
    .site-hero__foreground img{transform:scale(.8);transform-origin:right bottom}
    .site-hero[data-page="nosotros"] .site-hero__foreground img,
    .site-hero[data-page="contacto"] .site-hero__foreground img{transform:none}
    .site-hero[data-page="admisiones"] h1{white-space:normal}
    .site-hero[data-page="nosotros"] .site-hero__foreground,
    .site-hero[data-page="contacto"] .site-hero__foreground{left:25%}
  }
  @media(max-width:640px){
    .site-hero{min-height:0;align-items:stretch}
    .site-hero__photo,.site-hero__foreground{display:none}
    .site-hero__shade{inset:0;width:100%;border-radius:0}
    .site-hero__inner{padding-top:42px;padding-bottom:96px}
    .site-hero__eyebrow{font-size:.7rem}
    .site-hero h1{font-size:clamp(2.25rem,9vw,3.2rem);max-width:14ch}
    .site-hero__lead{font-size:1rem}
    .site-hero__detail{font-size:.9rem}
    .site-hero__actions{gap:10px}
    .site-hero__button{font-size:.78rem;padding:10px 13px;min-height:44px}
    .site-hero__wave{height:70px}
    .site-hero__orange{width:115px;height:85px;right:-35px}
    .site-hero__dots{right:8px;bottom:30px;width:55px}
  }
  @media(max-width:640px){
    .site-hero__copy{max-width:100%}
    .site-hero[data-page="nosotros"] h1,
    .site-hero[data-page="admisiones"] h1{font-size:clamp(2.15rem,9vw,3rem);white-space:normal}
    .site-hero__eyebrow{letter-spacing:.13em}
    .site-hero__lead,.site-hero__detail{max-width:40ch}
  }
  @media(max-width:420px){
    .site-hero__inner{padding-inline:18px;padding-bottom:92px}
    .site-hero h1{font-size:clamp(2.15rem,9vw,2.65rem)}
    .site-hero__actions{margin-top:18px}
    .site-hero__button{max-width:100%}
  }
  @media(max-width:390px){.site-hero__actions{flex-direction:column;align-items:stretch}.site-hero__button{justify-content:center}}
</style>
