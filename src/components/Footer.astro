---
import { getTranslation } from "../i18n/translations";

interface Props { lang?: "es" | "en" }
const { lang = "es" } = Astro.props;
const t = getTranslation(lang);
const year = new Date().getFullYear();
const address = lang === "es" ? "Calle San Andrés 307, Trujillo, La Libertad, Perú" : "San Andrés 307, Trujillo, La Libertad, Peru";
const privacyHref = lang === "es" ? "/es/privacidad" : "/en/privacy";
---

<footer class="site-footer">
  <svg class="site-footer__wave" viewBox="0 0 1440 42" preserveAspectRatio="none" aria-hidden="true"><path fill="#fff" d="M0 0h1440v17C1090 48 865 28 700 23 420 13 250 27 0 5Z" /></svg>
  <div class="site-footer__ornament site-footer__ornament--left" aria-hidden="true"></div>
  <div class="site-footer__ornament site-footer__ornament--right" aria-hidden="true"></div>
  <div class="container site-footer__container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href={`/${lang}`} aria-label="Boston Bilingual School — inicio"><img src="/logo-white.svg" alt="Boston Bilingual School" width="140" height="58" loading="lazy" /></a>
        <p>{t.footer.description}.</p>
        <address>
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>{address}</span>
          <a href="tel:+51976586016"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16.5v3a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 2.5 5.2 2 2 0 0 1 4.5 3h3a2 2 0 0 1 2 1.7l.4 2.6a2 2 0 0 1-.6 1.8L7.5 10.8a14 14 0 0 0 5.7 5.7l1.7-1.8a2 2 0 0 1 1.8-.6l2.6.4a2 2 0 0 1 1.7 2Z"/></svg>+51 976 586 016</a>
          <a href="mailto:info@boston.edu.pe"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="4" width="19" height="16" rx="2"/><path d="m3 6 9 7 9-7"/></svg>info@boston.edu.pe</a>
        </address>
      </div>
      <nav class="site-footer__column" aria-label={t.footer.academic}>
        <h2>{t.footer.academic}</h2>
        <a href={`/${lang}/primaria`}>{t.nav.primaria}</a>
        <a href="/secundaria">{t.nav.secundaria}</a>
        <a href={`/${lang}/#programas`}>{lang === "es" ? "Programas" : "Programs"}</a>
        <a href="/articulos">Blog</a>
      </nav>
      <nav class="site-footer__column" aria-label={t.footer.institutional}>
        <h2>{t.footer.institutional}</h2>
        <a href={`/${lang}/sobre-nosotros`}>{t.nav.about}</a>
        <a href={`/${lang}/admisiones`}>{t.nav.admisiones}</a>
        <a href={`/${lang}/contacto`}>{t.nav.contacto}</a>
        <a href={`/${lang}/#testimonios`}>{lang === "es" ? "Testimonios" : "Testimonials"}</a>
      </nav>
      <div class="site-footer__column site-footer__social">
        <h2>{t.footer.followUs}</h2>
        <p>{t.footer.connectSocial}</p>
        <div class="site-footer__social-links">
          <a href="https://www.facebook.com/1488366258147963" target="_blank" rel="noopener noreferrer" aria-label="Facebook">f</a>
          <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">◎</a>
          <a href="https://www.linkedin.com/company/boston-bilingual-school" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a>
          <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" aria-label="YouTube">▶</a>
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <small>© {year} Boston Preuniversitario. {t.footer.allRightsReserved}</small>
      <div class="site-footer__legal"><a href={privacyHref}>{lang === "es" ? "Uso de datos" : "Data use"}</a><span aria-hidden="true">|</span><a href={privacyHref}>{lang === "es" ? "Política de privacidad" : "Privacy policy"}</a></div>
    </div>
  </div>
</footer>

<style>
  .site-footer{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(118deg,#00346f 0%,#003d82 53%,#002e67 100%);color:#fff}
  .site-footer__wave{position:absolute;top:-1px;left:0;width:100%;height:42px}
  .site-footer__ornament{position:absolute;z-index:-1;border-radius:50%;pointer-events:none}
  .site-footer__ornament--left{left:-170px;top:10px;width:360px;height:360px;background:rgba(20,107,198,.22)}
  .site-footer__ornament--right{right:-135px;top:0;width:330px;height:330px;background:rgba(20,107,198,.21)}
  .site-footer__container{padding-top:84px;padding-bottom:24px}
  .site-footer__grid{display:grid;grid-template-columns:minmax(250px,2.2fr) repeat(3,minmax(125px,1fr));gap:clamp(25px,4vw,70px);padding-bottom:48px}
  .site-footer__logo{display:inline-block;line-height:0;margin-bottom:14px}
  .site-footer__logo img{width:140px;height:auto;max-height:62px;object-fit:contain;object-position:left center}
  .site-footer__brand p,.site-footer__social p{max-width:32ch;margin:0 0 15px;font-size:.9rem;line-height:1.55;color:#e7f0fb}
  .site-footer__brand address{display:grid;gap:8px;font-size:.84rem;font-style:normal;line-height:1.42}
  .site-footer__brand address span,.site-footer__brand address a{display:flex;align-items:flex-start;gap:9px;color:#ecf5ff;text-decoration:none}
  .site-footer__brand address svg{flex:none;width:15px;height:15px;fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;margin-top:2px}
  .site-footer__column{display:flex;flex-direction:column;align-items:flex-start;gap:9px;padding-top:17px}
  .site-footer__column h2{margin:0 0 10px;font-family:var(--font-accent);font-size:.98rem;font-weight:700;line-height:1.2;color:#fff}
  .site-footer__column>a{font-size:.88rem;color:#e7f0fb;text-decoration:none;line-height:1.4}
  .site-footer a:hover{color:#ffac31}
  .site-footer__social p{font-size:.88rem;margin:-1px 0 5px}
  .site-footer__social-links{display:flex;flex-wrap:wrap;gap:8px}
  .site-footer__social-links a{display:grid;place-items:center;width:34px;height:34px;border:1px solid #e29946;border-radius:50%;color:#fff;text-decoration:none;font-family:Arial,sans-serif;font-size:1rem;font-weight:700;line-height:1}
  .site-footer__social-links a:nth-child(3){font-size:.78rem}
  .site-footer__social-links a:nth-child(4){font-size:.7rem}
  .site-footer__social-links a:hover{background:var(--color-accent);border-color:var(--color-accent);color:#fff;transform:translateY(-2px)}
  .site-footer__bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-top:22px;border-top:1px solid rgba(255,255,255,.18);color:#bdcfe5;font-size:.78rem}
  .site-footer__bottom small{font-size:inherit}
  .site-footer__legal{display:flex;align-items:center;gap:11px;white-space:nowrap}
  .site-footer__legal a{color:inherit;text-decoration:none}
  @media(max-width:900px){.site-footer__grid{grid-template-columns:repeat(3,1fr);gap:30px}.site-footer__brand{grid-column:1/-1}.site-footer__brand p{max-width:50ch}}
  @media(max-width:600px){.site-footer__container{padding-top:65px}.site-footer__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:35px 22px;padding-bottom:37px}.site-footer__brand{grid-column:1/-1}.site-footer__column{padding-top:0}.site-footer__social{grid-column:1/-1}.site-footer__bottom{flex-direction:column;align-items:flex-start;gap:12px}.site-footer__legal{white-space:normal}}
</style>
