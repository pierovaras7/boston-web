---
import { getTranslation } from "../i18n/translations";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const t = getTranslation(lang);
const year = new Date().getFullYear();
const address = "Calle San Andrés 307, Trujillo, La Libertad, Perú";
const phone = "+51 976 586 016";
const email = "info@boston.edu.pe";
---

<footer class="footer">
	<div class="footer__wrapper">
		<div class="footer__content">
			<!-- Sección 1: Información Institucional -->
			<div class="footer__section footer__section--main">
				<h3>{t.footer.title}</h3>
				<p class="footer__description">{t.footer.description}</p>
				<div class="footer__info">
					<p class="footer__info-item">
						<span>{address}</span>
					</p>
					<p class="footer__info-item">
						<span>{phone}</span>
					</p>
					<p class="footer__info-item">
						<a href={`mailto:${email}`}>{email}</a>
					</p>
				</div>
			</div>

			<!-- Sección 2: Académico -->
			<div class="footer__section">
				<h3>{t.footer.academic}</h3>
				<ul>
					<li><a href={`/${lang}/primaria`}>{t.nav.primaria}</a></li>
					<li><a href="/secundaria">{t.nav.secundaria}</a></li>
					<li><a href={`/${lang}/#programas`}>{lang === 'es' ? 'Programas' : 'Programs'}</a></li>
					<li><a href="/articulos">Blog</a></li>
				</ul>
			</div>

			<!-- Sección 3: Institucional -->
			<div class="footer__section">
				<h3>{t.footer.institutional}</h3>
				<ul>
					<li><a href={`/${lang}/sobre-nosotros`}>{t.nav.about}</a></li>
					<li><a href={`/${lang}/admisiones`}>{t.nav.admisiones}</a></li>
					<li><a href={`/${lang}/contacto`}>{t.nav.contacto}</a></li>
					<li><a href={`/${lang}/#testimonios`}>{lang === 'es' ? 'Testimonios' : 'Testimonials'}</a></li>
				</ul>
			</div>

			<!-- Sección 4: Conectar -->
			<div class="footer__section">
				<h3>{t.footer.followUs}</h3>
				<p class="footer__social-text">{t.footer.connectSocial}</p>
				<div class="footer__social-links">
					<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="footer__social-icon" title="Facebook">f</a>
					<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="footer__social-icon" title="Instagram">@</a>
					<a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="footer__social-icon" title="LinkedIn">in</a>
					<a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="footer__social-icon" title="YouTube">▶</a>
				</div>
			</div>
		</div>

		<div class="footer__bottom">
			<div class="footer__bottom-content">
				<p>&copy; {year} Boston Preuniversitario. {t.footer.allRightsReserved}</p>
				<div class="footer__legal">
					<a href={lang === 'es' ? '/es/privacidad' : '/en/privacy'}>{lang === 'es' ? 'Uso de datos' : 'Data use'}</a>
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
		color: white;
		padding-top: 3rem;
		margin-top: 4rem;
	}

	.footer__wrapper {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.footer__content {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: 2.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.15);
		margin-bottom: 2rem;
	}

	.footer__section {
		display: flex;
		flex-direction: column;
	}

	.footer__section h3 {
		font-size: 1.1rem;
		margin: 0 0 1rem 0;
		font-weight: 700;
		font-family: var(--font-heading);
		color: white;
		text-transform: none;
		letter-spacing: 0;
	}

	.footer__section--main h3 {
		font-size: 1.3rem;
		margin-bottom: 0.75rem;
		color: white;
	}

	.footer__description {
		margin: 0 0 1.25rem 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: white;
		font-family: var(--font-body);
		font-weight: 400;
	}

	.footer__info {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer__info-item {
		margin: 0;
		font-size: 0.9rem;
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		color: white;
		font-family: var(--font-body);
		line-height: 1.5;
	}

	.footer__info-item strong {
		font-weight: 600;
		color: white;
	}

	.footer__info-item a {
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s ease;
	}

	.footer__info-item a:hover {
		color: white;
		text-decoration: underline;
	}

	.footer__section ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer__section li {
		margin: 0;
	}

	.footer__section a {
		color: white;
		text-decoration: none;
		transition: all 0.3s ease;
		font-family: var(--font-body);
		font-size: 0.95rem;
		opacity: 0.9;
	}

	.footer__section a:hover {
		color: var(--color-accent);
		opacity: 1;
		padding-left: 0.25rem;
	}

	.footer__social-text {
		margin: 0 0 1rem 0;
		font-size: 0.9rem;
		color: white;
		font-family: var(--font-body);
		opacity: 0.9;
	}

	.footer__social-links {
		display: flex;
		gap: 0.75rem;
	}

	.footer__social-icon {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 153, 0, 0.2);
		border: 1.5px solid var(--color-accent);
		border-radius: 50%;
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 600;
		font-size: 1rem;
		transition: all 0.3s ease;
		cursor: pointer;
	}

	.footer__social-icon:hover {
		background: var(--color-accent);
		color: white;
		transform: translateY(-3px);
	}

	.footer__bottom {
		padding: 1.5rem 0;
	}

	.footer__bottom-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.75);
		font-family: var(--font-body);
	}

	.footer__bottom-content p {
		margin: 0;
	}

	.footer__legal {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.footer__legal a {
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.footer__legal a:hover {
		color: var(--color-accent);
	}

	.footer__separator {
		color: rgba(255, 255, 255, 0.4);
	}

	@media (max-width: 1024px) {
		.footer__content {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem;
		}
	}

	@media (max-width: 768px) {
		.footer__content {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.footer__bottom-content {
			flex-direction: column;
			text-align: center;
		}

		.footer__legal {
			justify-content: center;
		}

		.footer {
			padding-top: 2rem;
			margin-top: 2rem;
		}
	}
</style>
