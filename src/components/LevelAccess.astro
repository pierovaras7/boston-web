---
import { Image } from "astro:assets";
import { getTranslation } from "../i18n/translations";
import primariasImg from "../assets/images/propuesta_academica/primaria/nia_primaria.jpg";
import secundariaImg from "../assets/images/propuesta_academica/secundaria/alumnos_secundaria.png";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const t = getTranslation(lang);
---

<section id="programas" class="level-access">
  <div class="container">
    <div class="level-access__header">
      <h2 class="level-access__title">{t.levels.title}</h2>
      <p class="level-access__subtitle">{t.levels.subtitle}</p>
    </div>

    <div class="level-access__grid">
      <a href={`/${lang}/primaria`} class="level-card">
        <div class="level-card__image">
          <Image
            src={primariasImg}
            alt="Primaria - Estudiantes"
            width={600}
            height={500}
          />
        </div>
        <div class="level-card__overlay">
          <h3 class="level-card__title">{t.levels.primary}</h3>
          <p class="level-card__desc">{t.levels.primaryDesc}</p>
          <div class="level-card__arrow">→</div>
        </div>
      </a>

      <a href="/secundaria" class="level-card">
        <div class="level-card__image">
          <Image
            src={secundariaImg}
            alt="Secundaria - Estudiantes"
            width={600}
            height={500}
          />
        </div>
        <div class="level-card__overlay">
          <h3 class="level-card__title">{t.levels.secondary}</h3>
          <p class="level-card__desc">{t.levels.secondaryDesc}</p>
          <div class="level-card__arrow">→</div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .level-access {
    padding: 7rem 0;
    background: linear-gradient(180deg, #f5f7fa 0%, #f0f3f7 100%);
  }

  .level-access__header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .level-access__title {
    font-size: 3.2rem;
    color: #003d82;
    margin: 0 0 1.2rem 0;
    font-family: var(--font-heading);
    font-weight: 900;
    letter-spacing: -1px;
  }

  .level-access__subtitle {
    font-size: 1.2rem;
    color: #666;
    margin: 0;
    font-family: var(--font-body);
    font-weight: 300;
    letter-spacing: 0.5px;
  }

  .level-access__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 4rem;
  }

  .level-card {
    position: relative;
    border-radius: 24px;
    text-decoration: none;
    box-shadow: 0 12px 48px rgba(0, 61, 130, 0.25);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    height: 500px;
    overflow: hidden;
    cursor: pointer;
  }

  .level-card:hover {
    transform: translateY(-16px);
    box-shadow: 0 28px 72px rgba(0, 61, 130, 0.35);
  }

  .level-card__image {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    overflow: hidden;
  }

  .level-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .level-card:hover .level-card__image img {
    transform: scale(1.08);
  }

  .level-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 61, 130, 0.35) 0%, rgba(255, 153, 0, 0.25) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 4rem 2.5rem 3rem;
    color: white;
    text-align: center;
    transition: all 0.4s ease;
    z-index: 2;
  }

  .level-card:hover .level-card__overlay {
    background: linear-gradient(135deg, rgba(0, 61, 130, 0.25) 0%, rgba(255, 153, 0, 0.15) 100%);
  }

  .level-card__title {
    font-size: 2.8rem;
    color: white;
    margin: 0 0 0.8rem 0;
    font-family: var(--font-heading);
    font-weight: 900;
    letter-spacing: -0.5px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .level-card__desc {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.95);
    margin: 0 0 2rem 0;
    font-family: var(--font-body);
    font-weight: 500;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }

  .level-card__arrow {
    font-size: 1.8rem;
    color: var(--color-accent);
    transition: transform 0.3s ease;
  }

  .level-card:hover .level-card__arrow {
    transform: translateX(8px);
  }

  @media (max-width: 768px) {
    .level-access {
      padding: 4rem 0;
    }

    .level-access__title {
      font-size: 2.4rem;
    }

    .level-access__grid {
      gap: 2.5rem;
    }

    .level-card {
      height: 420px;
    }

    .level-card__overlay {
      padding: 3rem 2rem 2.5rem;
    }

    .level-card__title {
      font-size: 2.2rem;
    }

    .level-card__desc {
      font-size: 1rem;
    }
  }
</style>
