---
import { Image } from 'astro:assets';
import pillarBilingual from '../assets/images/home/pilares/miss_y_alumno.png';
import pillarInnovation from '../assets/images/home/pilares/robotica_con_lego.png';
import pillarValues from '../assets/images/home/pilares/alumna_con_laptop.jpg';
import primaryPhoto from '../assets/images/propuesta_academica/primaria/nia_primaria.jpg';
import secondaryPhoto from '../assets/images/propuesta_academica/secundaria/alumnos_secundaria.png';
import familyPhoto1 from '../assets/images/home/testimonios/testimonio_1.png';
import familyPhoto2 from '../assets/images/home/testimonios/testimonio_2.png';
import familyPhoto3 from '../assets/images/home/testimonios/testimonio_3.png';
import familyPhoto4 from '../assets/images/home/testimonios/testimonio_4.png';
import newsRobotics from '../assets/images/home/pilares/robotica_con_lego.png';
import newsTrip from '../assets/images/propuesta_academica/primaria/marcha_de_alumnos.jpg';
import newsBilingual from '../assets/images/propuesta_academica/primaria/nia_boston_libr.png';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const base = `/${lang}`;
const copy = {
  es: {
    pillarsTitle: ['Pilares', 'Educativos'], pillarsIntro: 'Tres pilares que definen nuestra excelencia educativa y guían cada experiencia de aprendizaje.', pillarsLink: 'Conoce más sobre nuestro enfoque', learnAbout: 'Conoce más sobre',
    pillars: [
      { title: 'Bilingüismo', description: 'Enseñanza de inglés y francés con enfoque en certificación internacional, desde Primaria hasta Secundaria.', alt: 'Docente de Boston acompaña a un alumno' },
      { title: 'Innovación', description: 'Laboratorios de Robótica y Ajedrez integrados al plan de estudios regular, con enfoque en pensamiento crítico.', alt: 'Estudiantes de Boston construyen robots' },
      { title: 'Formación en Valores', description: 'Línea axiológica compuesta por Lealtad, Respeto, Responsabilidad, Integridad, Excelencia y más.', alt: 'Estudiante de Boston trabaja con una laptop' },
    ],
    programsEyebrow: 'NUESTROS PROGRAMAS', programsTitle: ['Un camino,', 'dos grandes', 'etapas'], programsIntro: 'Acompañamos cada etapa del desarrollo con una propuesta educativa integral, bilingüe y con visión global.', programsLink: 'Conoce nuestros programas',
    programs: [
      { title: 'Primaria', years: '1.º a 6.º grado', label: 'Conoce Primaria, de 1.º a 6.º grado', alt: 'Alumna de Primaria en su salón' },
      { title: 'Secundaria', years: '1.º a 5.º grado', label: 'Conoce Secundaria, de 1.º a 5.º grado', alt: 'Estudiantes de Secundaria en clase' },
    ],
    testimonialsEyebrow: 'TESTIMONIOS', testimonialsTitle: ['Historias que', 'nos', 'inspiran'], selectTestimonial: 'Seleccionar testimonio', showTestimonial: 'Mostrar testimonio', previousTestimonial: 'Testimonio anterior', nextTestimonial: 'Testimonio siguiente',
    testimonials: [
      { alt: 'Madre y estudiante de Boston', quote: 'Boston Bilingual School ha transformado la vida de nuestro hijo. Su dominio del inglés y su confianza en el aula han crecido enormemente. Los profesores son dedicados y el ambiente es inspirador.', author: 'Familia García', role: 'Padres de estudiante' },
      { alt: 'Madre e hijo de la comunidad Boston', quote: 'Me encanta estudiar en Boston. Los programas de robótica y ajedrez son increíbles, y mis amigos son lo mejor. Aquí no solo aprendo, sino que crezco como persona.', author: 'María, 5° grado', role: 'Estudiante' },
      { alt: 'Madre y alumno de secundaria', quote: 'El proyecto de ajedrez me enseñó a pensar estratégicamente. Los profesores crean un ambiente donde los errores son oportunidades de aprendizaje.', author: 'Luis, 3° grado', role: 'Estudiante' },
      { alt: 'Madre e hija de la comunidad Boston', quote: 'Como profesora, siento que tengo todas las herramientas para desarrollar el potencial de mis estudiantes. La escuela invierte en capacitación y recursos constantemente.', author: 'Dra. Rodríguez', role: 'Docente' },
    ],
    newsEyebrow: 'ACTUALIDAD BBS', newsTitle: ['Blog / Noticias', 'Destacadas'], newsIntro: 'Conoce las últimas noticias, logros y experiencias de nuestra comunidad.', newsLink: 'Ver todas las noticias', readMore: 'Leer más',
    news: [
      { category: 'Concurso', date: '14 de septiembre de 2024', dateTime: '2024-09-14', title: 'Estudiantes de Boston ganan Olimpiada de Robótica 2024', summary: 'Nuestros alumnos de primaria obtuvieron el primer lugar en la competencia nacional de robótica.', alt: 'Estudiantes desarrollan un proyecto de robótica' },
      { category: 'Evento', date: '9 de septiembre de 2024', dateTime: '2024-09-09', title: 'Viaje de Estudio a la Amazonía Peruana', summary: 'Nuestros estudiantes de secundaria exploraron la biodiversidad y culturas amazónicas.', alt: 'Estudiantes de Boston participan en una actividad cultural' },
      { category: 'Educativo', date: '31 de agosto de 2024', dateTime: '2024-08-31', title: 'Bilingüismo como Herramienta para la Ciudadanía Global', summary: 'Cómo nuestro enfoque bilingüe prepara a los estudiantes para un mundo global.', alt: 'Estudiante de Boston leyendo en el aula' },
    ],
    statsLabel: 'Boston Bilingual School en cifras', stats: [
      { value: '+15 años', label: 'formando líderes globales' }, { value: '+1,200', label: 'estudiantes en nuestra comunidad' },
      { value: '2 idiomas', label: 'inglés y francés' }, { value: 'Excelencia', label: 'académica y valores sólidos' },
    ],
  },
  en: {
    pillarsTitle: ['Educational', 'Pillars'], pillarsIntro: 'Three pillars define our educational excellence and guide every learning experience.', pillarsLink: 'Learn more about our approach', learnAbout: 'Learn more about',
    pillars: [
      { title: 'Bilingualism', description: 'English and French instruction focused on international certification, from Primary through Secondary School.', alt: 'Boston teacher supporting a student' },
      { title: 'Innovation', description: 'Robotics and chess labs are part of the regular curriculum, with a focus on critical thinking.', alt: 'Boston students building robots' },
      { title: 'Values Education', description: 'Our guiding values include loyalty, respect, responsibility, integrity and excellence.', alt: 'Boston student working on a laptop' },
    ],
    programsEyebrow: 'OUR PROGRAMS', programsTitle: ['One path,', 'two important', 'stages'], programsIntro: 'We support every stage of development with a comprehensive, bilingual education and a global outlook.', programsLink: 'Explore our programs',
    programs: [
      { title: 'Primary', years: 'Grades 1–6', label: 'Explore Primary, grades 1 through 6', alt: 'Primary student in her classroom' },
      { title: 'Secondary', years: 'Grades 1–5', label: 'Explore Secondary, grades 1 through 5', alt: 'Secondary students in class' },
    ],
    testimonialsEyebrow: 'TESTIMONIALS', testimonialsTitle: ['Stories that', 'truly', 'inspire'], selectTestimonial: 'Select a testimonial', showTestimonial: 'Show testimonial', previousTestimonial: 'Previous testimonial', nextTestimonial: 'Next testimonial',
    testimonials: [
      { alt: 'Mother and Boston student', quote: "Boston Bilingual School has transformed our son's life. His English skills and confidence in the classroom have grown tremendously. The teachers are dedicated and the atmosphere is inspiring.", author: 'García Family', role: 'Student’s parents' },
      { alt: 'Mother and son from the Boston community', quote: 'I love studying at Boston. The robotics and chess programs are amazing, and my friends are the best. Here I do more than learn: I grow as a person.', author: 'María, grade 5', role: 'Student' },
      { alt: 'Mother and secondary student', quote: 'Chess taught me to think strategically. The teachers create an environment where mistakes become opportunities to learn.', author: 'Luis, grade 3', role: 'Student' },
      { alt: 'Mother and daughter from the Boston community', quote: 'As a teacher, I have the tools to help my students reach their potential. The school continually invests in training and resources.', author: 'Dr. Rodríguez', role: 'Teacher' },
    ],
    newsEyebrow: 'BBS UPDATES', newsTitle: ['Blog / Featured', 'News'], newsIntro: 'Discover the latest news, achievements and experiences from our community.', newsLink: 'See all news', readMore: 'Read more',
    news: [
      { category: 'Competition', date: 'September 14, 2024', dateTime: '2024-09-14', title: 'Boston Students Win the 2024 Robotics Olympiad', summary: 'Our primary students won first place in a national robotics competition.', alt: 'Students working on a robotics project' },
      { category: 'Event', date: 'September 9, 2024', dateTime: '2024-09-09', title: 'Study Trip to the Peruvian Amazon', summary: 'Our secondary students explored Amazonian biodiversity and cultures.', alt: 'Boston students taking part in a cultural activity' },
      { category: 'Education', date: 'August 31, 2024', dateTime: '2024-08-31', title: 'Bilingualism as a Tool for Global Citizenship', summary: 'How our bilingual approach prepares students for a global world.', alt: 'Boston student reading in class' },
    ],
    statsLabel: 'Boston Bilingual School in numbers', stats: [
      { value: '15+ years', label: 'developing global leaders' }, { value: '1,200+', label: 'students in our community' },
      { value: '2 languages', label: 'English and French' }, { value: 'Excellence', label: 'in academics and values' },
    ],
  },
} as const;
const t = copy[lang];
const pillars = t.pillars.map((item, i) => ({ ...item, image: [pillarBilingual, pillarInnovation, pillarValues][i], icon: ['globe', 'light', 'people'][i], href: i === 2 ? `${base}/sobre-nosotros` : `${base}/primaria` }));
const testimonials = t.testimonials.map((item, i) => ({ ...item, image: [familyPhoto1, familyPhoto2, familyPhoto3, familyPhoto4][i] }));
const newsSlugs = lang === 'es'
  ? ['olimpiada-robotica-2024', 'viaje-estudio-naturaleza', 'bilingüismo-ciudadania-global']
  : ['robotics-olympiad-2024', 'amazon-study-trip', 'bilingualism-global-citizenship'];
const news = t.news.map((item, i) => ({ ...item, image: [newsRobotics, newsTrip, newsBilingual][i], href: `/articulos/${newsSlugs[i]}`, tone: ['green', 'purple', 'orange'][i] }));
---

<section class="hb-pillars" id="pilares" aria-labelledby="pillars-title">
  <div class="hb-wrap">
    <div class="hb-section-head">
      <h2 id="pillars-title">{t.pillarsTitle[0]} <span>{t.pillarsTitle[1]}</span></h2>
      <div class="hb-head-aside"><p>{t.pillarsIntro}</p><a href={`${base}/sobre-nosotros`}>{t.pillarsLink} <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="hb-pillar-grid">
      {pillars.map((pillar) => <article class="hb-pillar-card">
        <div class="hb-pillar-copy">
          <span class={`hb-pillar-icon hb-icon-${pillar.icon}`} aria-hidden="true">
            {pillar.icon === 'globe' && <svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="11"/><path d="M5 16h22M16 5c-5 5-5 17 0 22M16 5c5 5 5 17 0 22M8 10h16M8 22h16"/></svg>}
            {pillar.icon === 'light' && <svg viewBox="0 0 32 32" fill="none"><path d="M11 22h10M12 25h8M14 28h4M16 4v3M5 16H2m28 0h-3M6 6l2.5 2.5M26 6l-2.5 2.5M8 25l2.5-2.5M24 25l-2.5-2.5"/><path d="M10 20c-2-2-3-4-3-7a9 9 0 0 1 18 0c0 3-1 5-3 7l-1 2H11z"/></svg>}
            {pillar.icon === 'people' && <svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="11" r="4"/><path d="M8 26v-3a8 8 0 0 1 16 0v3H8ZM7 13a3 3 0 1 0 0-6M4 24v-3a6 6 0 0 1 4-5M25 13a3 3 0 1 1 0-6M28 24v-3a6 6 0 0 0-4-5"/></svg>}
          </span>
          <div class="hb-pillar-text"><h3>{pillar.title}</h3><p>{pillar.description}</p></div>
          <a class="hb-round-link hb-pillar-link" href={pillar.href} aria-label={`${t.learnAbout} ${pillar.title}`}>→</a>
        </div>
        <div class="hb-pillar-photo"><Image src={pillar.image} alt={pillar.alt} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 33vw" loading="lazy" /></div>
      </article>)}
    </div>
  </div>
</section>

<section class="hb-programs" id="programas" aria-labelledby="programs-title">
  <div class="hb-wrap hb-program-layout">
    <div class="hb-program-copy">
      <p class="hb-eyebrow">{t.programsEyebrow}</p>
      <h2 id="programs-title">{t.programsTitle[0]}<br />{t.programsTitle[1]}<br /><span>{t.programsTitle[2]}</span></h2>
      <p>{t.programsIntro}</p>
      <a class="hb-orange-button" href={`${base}/primaria`}>{t.programsLink} <span aria-hidden="true">→</span></a>
    </div>
    <div class="hb-program-cards">
      <a class="hb-program-card hb-program-primary" href={`${base}/primaria`} aria-label={t.programs[0].label}>
        <Image src={primaryPhoto} alt={t.programs[0].alt} widths={[400, 800]} sizes="(max-width: 760px) 100vw, 27vw" loading="lazy" />
        <span class="hb-program-overlay"><strong>{t.programs[0].title}</strong><small>{t.programs[0].years}</small></span><span class="hb-round-link" aria-hidden="true">→</span>
      </a>
      <a class="hb-program-card hb-program-secondary" href={`${base}/secundaria`} aria-label={t.programs[1].label}>
        <Image src={secondaryPhoto} alt={t.programs[1].alt} widths={[400, 800]} sizes="(max-width: 760px) 100vw, 27vw" loading="lazy" />
        <span class="hb-program-overlay"><strong>{t.programs[1].title}</strong><small>{t.programs[1].years}</small></span><span class="hb-round-link" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<section class="hb-testimonials" id="testimonios" aria-labelledby="testimonials-title">
  <div class="hb-wrap hb-testimonials-layout">
    <div class="hb-testimonial-photo"><div class="hb-testimonial-images">
      {testimonials.map((item, i) => <Image src={item.image} alt={item.alt} class={i === 0 ? 'is-active' : ''} data-testimonial-image={i} widths={[600, 1000]} sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" />)}
    </div></div>
    <div class="hb-testimonial-copy">
      <p class="hb-eyebrow">{t.testimonialsEyebrow}</p>
      <h2 id="testimonials-title">{t.testimonialsTitle[0]}<br />{t.testimonialsTitle[1]} <span>{t.testimonialsTitle[2]}</span></h2>
      <div class="hb-testimonial-bottom"><div class="hb-dots" aria-hidden="true">
        {testimonials.map((_, i) => <span class={i === 0 ? 'is-active' : ''} data-testimonial-dot={i}></span>)}
      </div><div class="hb-testimonial-arrows"><button type="button" data-testimonial-prev aria-label={t.previousTestimonial}>‹</button><button type="button" data-testimonial-next aria-label={t.nextTestimonial}>›</button></div></div>
      <div class="hb-testimonial-content" aria-live="polite">
        {testimonials.map((item, i) => <div class={`hb-testimonial-item ${i === 0 ? 'is-active' : ''}`} data-testimonial-item={i}>
          <blockquote>“{item.quote}”</blockquote><strong>{item.author}</strong><small>{item.role}</small>
        </div>)}
      </div>
    </div>
  </div>
</section>

<section class="hb-news" id="noticias" aria-labelledby="news-title">
  <div class="hb-wrap">
    <div class="hb-section-head hb-news-head">
      <div><p class="hb-eyebrow">{t.newsEyebrow}</p><h2 id="news-title">{t.newsTitle[0]} <span>{t.newsTitle[1]}</span></h2></div>
      <div class="hb-head-aside"><p>{t.newsIntro}</p><a href={`${base}/articulos`}>{t.newsLink} <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="hb-news-grid">
      {news.map((item) => <article class="hb-news-card">
        <a class="hb-news-photo" href={item.href} aria-label={item.title}><Image src={item.image} alt={item.alt} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 33vw" loading="lazy" /></a>
        <div class="hb-news-content"><div class="hb-news-meta"><span class={`hb-badge hb-badge-${item.tone}`}>{item.category}</span><time datetime={item.dateTime}>{item.date}</time></div><h3><a href={item.href}>{item.title}</a></h3><p>{item.summary}</p><a class="hb-read-link" href={item.href}>{t.readMore} <span aria-hidden="true">→</span></a></div>
      </article>)}
    </div>
  </div>
</section>

<section class="hb-stats" aria-label={t.statsLabel}><div class="hb-wrap hb-stats-grid">
  <div class="hb-stat"><svg viewBox="0 0 36 36" aria-hidden="true"><path d="M3 11 18 5l15 6-15 6L3 11Zm6 5v8c6 5 12 5 18 0v-8M33 11v14"/></svg><strong>{t.stats[0].value}</strong><span>{t.stats[0].label}</span></div>
  <div class="hb-stat"><svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="10" r="4"/><circle cx="8" cy="13" r="3"/><circle cx="28" cy="13" r="3"/><path d="M10 28v-5a8 8 0 0 1 16 0v5H10ZM3 27v-5a6 6 0 0 1 6-6M33 27v-5a6 6 0 0 0-6-6"/></svg><strong>{t.stats[1].value}</strong><span>{t.stats[1].label}</span></div>
  <div class="hb-stat"><svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="13"/><path d="M5 18h26M18 5c-6 7-6 19 0 26M18 5c6 7 6 19 0 26M9 10h18M9 26h18"/></svg><strong>{t.stats[2].value}</strong><span>{t.stats[2].label}</span></div>
  <div class="hb-stat"><svg viewBox="0 0 36 36" aria-hidden="true"><path d="m18 3 4.4 9 10 1.5-7.2 7 1.7 10L18 26l-8.9 4.5 1.7-10-7.2-7 10-1.5L18 3Z"/></svg><strong>{t.stats[3].value}</strong><span>{t.stats[3].label}</span></div>
</div></section>

<script>
  const section = document.querySelector('.hb-testimonials');
  if (section) {
    const images = [...section.querySelectorAll<HTMLElement>('[data-testimonial-image]')];
    const items = [...section.querySelectorAll<HTMLElement>('[data-testimonial-item]')];
    const dots = [...section.querySelectorAll<HTMLElement>('[data-testimonial-dot]')];
    let active = 0;
    const show = (next: number) => {
      active = (next + items.length) % items.length;
      images.forEach((image, i) => image.classList.toggle('is-active', i === active));
      items.forEach((item, i) => item.classList.toggle('is-active', i === active));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === active));
    };
    section.querySelector('[data-testimonial-prev]')?.addEventListener('click', () => show(active - 1));
    section.querySelector('[data-testimonial-next]')?.addEventListener('click', () => show(active + 1));
  }
</script>

<style>
  .hb-wrap{width:min(100%,1280px);margin-inline:auto;padding-inline:32px}
  .hb-pillars,.hb-programs,.hb-testimonials,.hb-news,.hb-stats{color:#073469;overflow:hidden}
  .hb-pillars h2,.hb-programs h2,.hb-testimonials h2,.hb-news h2{margin:0;font-family:var(--font-heading);font-weight:900;letter-spacing:-.055em;line-height:1.05}
  .hb-pillars h2 span,.hb-programs h2 span,.hb-testimonials h2 span,.hb-news h2 span{color:#ff8900}
  .hb-eyebrow{margin:0 0 12px;color:#7890aa;font-size:.79rem;font-weight:800;letter-spacing:.16em;line-height:1.2}
  .hb-pillars{padding:72px 0 16px;background:#fff}
  .hb-section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:40px;margin-bottom:48px}
  .hb-section-head h2{font-size:clamp(2.3rem,3.6vw,3.3rem)}
  .hb-head-aside{width:300px;flex:none;padding-top:5px}
  .hb-head-aside p{margin:0 0 10px;color:#5d6671;font-size:.93rem;line-height:1.45}
  .hb-head-aside a{color:#06427d;font-size:.84rem;font-weight:800;text-decoration:none}
  .hb-head-aside a:hover,.hb-read-link:hover{text-decoration:underline}
  .hb-pillar-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
  .hb-pillar-card{height:565px;border-radius:16px;background:#f8fbff;box-shadow:0 7px 26px rgba(25,72,126,.09);overflow:hidden;transition:transform .2s ease,box-shadow .2s ease}
  .hb-pillar-card:hover{transform:translateY(-4px);box-shadow:0 14px 32px rgba(25,72,126,.16)}
  .hb-pillar-copy{position:relative;display:grid;grid-template-columns:80px 1fr;gap:13px;height:200px;padding:0 22px 12px 22px;background:linear-gradient(145deg,#fbfdff,#f4f8fd)}
  .hb-pillar-icon{display:grid;place-items:center;width:78px;height:78px;border-radius:50%;background:#00458f;color:#fff;box-shadow:0 7px 15px rgba(0,61,130,.2)}
  .hb-icon-light{background:#ff8c00;box-shadow:0 7px 15px rgba(255,137,0,.25)}
  .hb-pillar-icon svg{width:35px;height:35px;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .hb-pillar-text{padding-top:22px}
  .hb-pillar-text h3{margin:0 0 10px;font-size:1.21rem;font-weight:800;line-height:1.1;letter-spacing:-.04em}
  .hb-pillar-text p{margin:0;color:#5e6975;font-size:.83rem;line-height:1.45}
  .hb-round-link{display:grid;place-items:center;width:42px;height:42px;flex:none;border-radius:50%;background:#fff;color:#03468e;font-size:1.25rem;font-weight:600;text-decoration:none;box-shadow:0 5px 15px rgba(9,50,104,.12)}
  .hb-pillar-link{position:absolute;left:29px;bottom:16px}
  .hb-pillar-photo{height:365px;overflow:hidden}
  .hb-pillar-photo :global(img){display:block;width:100%;height:100%;object-fit:cover;object-position:center 35%}
  .hb-pillar-card:nth-child(2) .hb-pillar-photo :global(img){object-position:center 35%}
  .hb-pillar-card:nth-child(3) .hb-pillar-photo :global(img){object-position:center 44%}
  .hb-programs{position:relative;padding:109px 0 73px;background:linear-gradient(125deg,#f5f9fd,#fff 52%,#f4f8fc)}
  .hb-program-layout{display:grid;grid-template-columns:34% 1fr;align-items:center;gap:48px}
  .hb-program-copy{position:relative;z-index:1}
  .hb-program-copy h2{font-size:clamp(2.6rem,3.3vw,3.3rem)}
  .hb-program-copy>p:not(.hb-eyebrow){max-width:350px;margin:22px 0 24px;color:#606b76;font-size:1rem;line-height:1.5}
  .hb-orange-button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:54px;padding:15px 21px;border-radius:7px;background:#ff9000;color:#fff;font-size:.87rem;font-weight:800;text-decoration:none;box-shadow:0 7px 13px rgba(255,145,0,.17)}
  .hb-orange-button:hover{background:#ef7900;transform:translateY(-2px)}
  .hb-program-cards{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
  .hb-program-cards::before,.hb-program-cards::after{content:"";position:absolute;z-index:0;border-radius:34px;pointer-events:none}
  .hb-program-cards::before{width:53%;height:48%;left:-28px;bottom:-28px;background:#a8d0ff}
  .hb-program-cards::after{width:39%;height:44%;right:-28px;top:-28px;background:#a8d0ff}
  .hb-program-card{position:relative;z-index:1;display:block;height:428px;border-radius:30px;overflow:hidden;color:#fff;text-decoration:none;box-shadow:0 9px 22px rgba(0,47,105,.12)}
  .hb-program-card :global(img){display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .hb-program-secondary :global(img){object-position:43% center}
