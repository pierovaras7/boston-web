---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { Font } from "astro:assets";

interface Props {
	title?: string;
	description?: string;
	lang?: "es" | "en";
	alternateLanguageHref?: string;
}

const {
	title = "Boston Bilingual School",
	lang = "es",
	alternateLanguageHref,
} = Astro.props;

const langAttr = lang === "en" ? "en" : "es";
const pageDescription = Astro.props.description ?? (lang === "en"
	? "Developing global citizens through academic excellence and internationally certified language education."
	: "Formamos ciudadanos globales con excelencia académica y certificación internacional en idiomas.");
---

<html lang={langAttr}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=bbs-1" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={pageDescription} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ff9900" />
		<Font cssVariable="--astro-font-heading" preload={[{ weight: 900, subset: "latin" }]} />
		<Font cssVariable="--astro-font-body" />
		<Font cssVariable="--astro-font-accent" />
		<title>{title}</title>
		<style>
			html {
				scroll-behavior: smooth;
			}
		</style>
	</head>
	<body>
		<Header lang={lang} />
		<slot />
		<script define:vars={{ lang, alternateLanguageHref }}>
			document.addEventListener('DOMContentLoaded', () => {
				const langSwitcher = document.getElementById('lang-toggle');
				if (!langSwitcher) return;
				const currentLang = lang;
				const esBtn = langSwitcher.querySelector('[data-lang="es"]');
				const enBtn = langSwitcher.querySelector('[data-lang="en"]');
				if (currentLang === 'es') {
					esBtn.setAttribute('data-active', 'true');
					enBtn.removeAttribute('data-active');
				} else {
					enBtn.setAttribute('data-active', 'true');
					esBtn.removeAttribute('data-active');
				}
				[esBtn, enBtn].forEach(btn => {
					btn.addEventListener('click', (e) => {
						e.stopPropagation();
						const targetLang = btn.getAttribute('data-lang');
						if (targetLang === currentLang) return;
						localStorage.setItem('preferredLang', targetLang);
						let newPath = window.location.pathname;
						if (currentLang === 'es') {
							newPath = newPath.replace(/^\/es\//, '/en/');
							if (newPath === '/es') newPath = '/en';
						} else {
							newPath = newPath.replace(/^\/en\//, '/es/');
							if (newPath === '/en') newPath = '/es';
						}
						window.location.href = alternateLanguageHref || newPath;
					});
				});
			});
		</script>
		<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"199f252fc0be4505b9dffec3493a56bc"}'></script>
	</body>
</html>
