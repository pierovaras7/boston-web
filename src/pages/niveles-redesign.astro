---
import { Image } from "astro:assets";
import primariasImg from "../assets/images/propuesta_academica/primaria/nia_primaria.jpg";
import secundariaImg from "../assets/images/propuesta_academica/secundaria/alumnos_secundaria.png";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rediseño - Propuesta por Niveles</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #f5f5f5;
      padding: 3rem 2rem;
    }

    h1 {
      text-align: center;
      color: #003d82;
      margin-bottom: 3rem;
      font-size: 2.5rem;
    }

    .section-bg {
      padding: 6rem 2rem;
      margin-bottom: 4rem;
      border-radius: 12px;
    }

    /* OPCIÓN A: Full Width Image con Texto Superpuesto */
    .option-a .section-bg {
      background: linear-gradient(180deg, #1e3a5f 0%, #2c4a75 100%);
    }

    .option-a h2 {
      text-align: center;
      color: white;
      font-size: 3rem;
      margin-bottom: 4rem;
      font-weight: 900;
    }

    .option-a .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .option-a .card {
      position: relative;
      height: 500px;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 16px 48px rgba(0, 61, 130, 0.3);
      cursor: pointer;
    }

    .option-a .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .option-a .overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(0, 61, 130, 0.7) 0%, rgba(255, 153, 0, 0.6) 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      padding: 3rem 2rem;
      color: white;
      text-align: center;
      transition: all 0.4s ease;
    }

    .option-a .card:hover .overlay {
      background: linear-gradient(135deg, rgba(0, 61, 130, 0.5) 0%, rgba(255, 153, 0, 0.4) 100%);
    }

    .option-a .title {
      font-size: 2.8rem;
      font-weight: 900;
      margin-bottom: 1rem;
    }

    .option-a .desc {
      font-size: 1.2rem;
      font-weight: 500;
      margin-bottom: 2rem;
    }

    .option-a .arrow {
      font-size: 2rem;
      transition: transform 0.3s ease;
    }

    .option-a .card:hover .arrow {
      transform: translateX(10px);
    }

    @media (max-width: 900px) {
      .option-a .grid {
        grid-template-columns: 1fr;
      }
    }

    /* OPCIÓN B: Alternancia Left/Right */
    .option-b .section-bg {
      background: linear-gradient(180deg, #1e3a5f 0%, #2c4a75 100%);
    }

    .option-b h2 {
      text-align: center;
      color: white;
      font-size: 3rem;
      margin-bottom: 5rem;
      font-weight: 900;
    }

    .option-b .level {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      margin-bottom: 6rem;
      max-width: 1200px;
      margin-left: auto;
      margin-right: auto;
    }

    .option-b .level:nth-child(3) {
      grid-template-columns: 1fr 1fr;
      direction: rtl;
    }

    .option-b .level:nth-child(3) > * {
      direction: ltr;
    }

    .option-b .image {
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      height: 450px;
    }

    .option-b .image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .option-b .content {
      color: white;
    }

    .option-b .number {
      font-size: 6rem;
      font-weight: 900;
      background: linear-gradient(135deg, #ff9900 0%, #ff7c00 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1;
      margin-bottom: 1rem;
    }

    .option-b .title {
      font-size: 2.8rem;
      font-weight: 900;
      margin-bottom: 1.5rem;
    }

    .option-b .desc {
      font-size: 1.1rem;
      line-height: 1.8;
      margin-bottom: 2rem;
      opacity: 0.95;
    }

    .option-b .cta {
      display: inline-block;
      padding: 1rem 2.5rem;
      background: linear-gradient(135deg, #ff9900 0%, #ff7c00 100%);
      color: white;
      text-decoration: none;
      border-radius: 50px;
      font-weight: 700;
      transition: all 0.3s ease;
    }

    .option-b .cta:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(255, 153, 0, 0.4);
    }

    @media (max-width: 900px) {
      .option-b .level {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .option-b .level:nth-child(3) {
        grid-template-columns: 1fr;
        direction: ltr;
      }

      .option-b .number {
        font-size: 4rem;
      }

      .option-b .title {
        font-size: 2rem;
      }
    }

    /* OPCIÓN C: Tabs/Pestañas */
    .option-c .section-bg {
      background: linear-gradient(180deg, #1e3a5f 0%, #2c4a75 100%);
    }

    .option-c h2 {
      text-align: center;
      color: white;
      font-size: 3rem;
      margin-bottom: 4rem;
      font-weight: 900;
    }

    .option-c .tabs-container {
      max-width: 1000px;
      margin: 0 auto;
    }

    .option-c .tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .option-c .tab-btn {
      padding: 2rem;
      background: rgba(255, 255, 255, 0.1);
      border: 2px solid rgba(255, 255, 255, 0.3);
      color: white;
      border-radius: 16px;
      font-size: 1.4rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .option-c .tab-btn.active {
      background: linear-gradient(135deg, #ff9900 0%, #ff7c00 100%);
      border-color: #ff9900;
    }

    .option-c .tab-content {
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .option-c .tab-image {
      height: 400px;
      overflow: hidden;
    }

    .option-c .tab-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .option-c .tab-info {
      padding: 3rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .option-c .tab-title {
      font-size: 2.4rem;
      color: #003d82;
      font-weight: 900;
      margin-bottom: 1rem;
    }

    .option-c .tab-desc {
      font-size: 1.1rem;
      color: #666;
      line-height: 1.8;
      margin-bottom: 2rem;
    }

    .option-c .tab-btn.active::after {
      content: '→';
      margin-left: 1rem;
    }

    @media (max-width: 900px) {
      .option-c .tab-content {
        grid-template-columns: 1fr;
      }

      .option-c .tab-image {
        height: 300px;
      }
    }

    .desc-box {
      background: white;
      padding: 1.5rem;
      border-radius: 8px;
      margin-top: 2rem;
      border-left: 4px solid #ff9900;
    }

    .desc-box strong {
      color: #003d82;
    }
  </style>
</head>
<body>
  <h1>🎨 Rediseño - Propuesta por Niveles</h1>

  <!-- OPCIÓN A -->
  <div class="option-a">
    <div class="section-bg">
      <h2>Propuesta por Niveles</h2>
      <div class="grid">
        <div class="card">
          <img src={primariasImg.src} alt="Primaria">
          <div class="overlay">
            <div class="title">Primaria</div>
            <div class="desc">1° a 6° grado</div>
            <div class="arrow">→</div>
          </div>
        </div>
        <div class="card">
          <img src={secundariaImg.src} alt="Secundaria">
          <div class="overlay">
            <div class="overlay">
            <div class="title">Secundaria</div>
            <div class="desc">1° a 5° grado</div>
            <div class="arrow">→</div>
          </div>
          </div>
        </div>
      </div>
    </div>
    <div class="desc-box">
      <strong>Opción A - Overlay Gradient Premium:</strong> Tarjetas grandes con gradiente overlay, texto centrado en la base. Muy impactante y directo.
    </div>
  </div>

  <!-- OPCIÓN B -->
  <div class="option-b">
    <div class="section-bg">
      <h2>Propuesta por Niveles</h2>

      <div class="level">
        <div class="image">
          <img src={primariasImg.src} alt="Primaria">
        </div>
        <div class="content">
          <div class="number">1</div>
          <div class="title">Primaria</div>
          <div class="desc">Educación integral desde 1° a 6° grado. Enfoque en bilingüismo, innovación y valores que moldean ciudadanos globales responsables.</div>
          <a href="/primaria" class="cta">Conocer más →</a>
        </div>
      </div>

      <div class="level">
        <div class="image">
          <img src={secundariaImg.src} alt="Secundaria">
        </div>
        <div class="content">
          <div class="number">2</div>
          <div class="title">Secundaria</div>
          <div class="desc">Formación de líderes de 1° a 5° grado. Programas avanzados que preparan para desafíos globales con excelencia académica.</div>
          <a href="/secundaria" class="cta">Conocer más →</a>
        </div>
      </div>
    </div>
    <div class="desc-box">
      <strong>Opción B - Alternancia Left/Right:</strong> Imagen grande alternada con contenido. Muy épico, editorial. Números grandes degradados. CTAs prominentes.
    </div>
  </div>

  <!-- OPCIÓN C -->
  <div class="option-c">
    <div class="section-bg">
      <h2>Propuesta por Niveles</h2>
      <div class="tabs-container">
        <div class="tabs">
          <button class="tab-btn active">📚 Primaria (1°-6°)</button>
          <button class="tab-btn">🚀 Secundaria (1°-5°)</button>
        </div>
        <div class="tab-content">
          <div class="tab-image">
            <img src={primariasImg.src} alt="Primaria">
          </div>
          <div class="tab-info">
            <div class="tab-title">Primaria</div>
            <div class="tab-desc">Programa bilingüe integral que forma estudiantes con excelencia académica, pensamiento crítico y valores sólidos desde 1° a 6° grado.</div>
            <a href="/primaria" class="cta">Explorar programa</a>
          </div>
        </div>
      </div>
    </div>
    <div class="desc-box">
      <strong>Opción C - Tabs/Pestañas:</strong> Sistema de pestañas interactivo. Contenido dinámico. Muy moderno y usable. Énfasis en interacción.
    </div>
  </div>

</body>
</html>
