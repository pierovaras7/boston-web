---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import SiteHero from "../../components/SiteHero.astro";
import AboutBody from "../../components/AboutBody.astro";
---

<Layout title="Sobre Nosotros - Boston Bilingual School" lang="es">
  <main class="about-es-page">
    <SiteHero page="nosotros" lang="es" />
    <AboutBody />
  </main>
  <Footer lang="es" />
</Layout>

<style>
  .about-es-page :global(.site-hero__photo){background:url('/images/nosotros/campus-boston-hero.webp') right center / cover no-repeat}
  .about-es-page :global(.site-hero__photo img){visibility:hidden}
  @media(max-width:640px){.about-es-page :global(.site-hero__photo){background-position:74% center}}
</style>
