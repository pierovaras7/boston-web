---
import Layout from "../../layouts/Layout.astro";
import { getTranslation } from "../../i18n/translations";
import Footer from "../../components/Footer.astro";
import SiteHero from "../../components/SiteHero.astro";
import FeatureStrip from "../../components/FeatureStrip.astro";
import ActionPanel from "../../components/ActionPanel.astro";

const lang = "es";
const t = getTranslation(lang);
---

<Layout title="Primaria - Boston Bilingual School" lang={lang}>
	<main class="level-page" data-level="primaria">
		<SiteHero page="primaria" lang={lang} />
		<FeatureStrip page="primaria" lang={lang} />

		<section id="plan-estudios" class="curriculum">
			<div class="container">
				<h2>Plan de Estudios</h2>

				<div class="curriculum-grid">
					<div>
						<h3>1° y 2° Grado</h3>
						<ul>
							<li>Matemática</li>
							<li>Comunicación</li>
							<li>Ciencia y Ambiente</li>
							<li>Personal Social</li>
							<li>Música</li>
							<li>Robótica</li>
							<li>Inglés</li>
							<li>Educación Física</li>
							<li>Ajedrez</li>
							<li>Tutoría</li>
						</ul>
					</div>

					<div>
						<h3>3° a 6° Grado</h3>
						<ul>
							<li>Matemática</li>
							<li>Comunicación</li>
							<li>Ciencia y Tecnología</li>
							<li>Personal Social</li>
							<li>Robótica</li>
							<li>Inglés</li>
							<li>Francés</li>
							<li>Educación Física</li>
							<li>Ajedrez</li>
							<li>Tutoría</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="programs">
			<div class="container">
				<h2>Programas Especiales</h2>

				<div class="programs-grid">
					<article>
						<h3>Robótica</h3>
						<p>Curso regular en toda la trayectoria escolar con laboratorio dedicado para el desarrollo de proyectos tecnológicos innovadores.</p>
					</article>

					<article>
						<h3>Ajedrez</h3>
						<p>Programa de ajedrez integrado que desarrolla pensamiento estratégico, concentración y toma de decisiones.</p>
					</article>

					<article>
						<h3>Bilingüismo</h3>
						<p>Inmersión en inglés desde el inicio y francés desde 3er grado con certificación internacional.</p>
					</article>

					<article>
						<h3>Actividades Complementarias</h3>
						<p>Reforzamiento académico, visitas educativas a museos y sitios arqueológicos, preparación para concursos.</p>
					</article>
				</div>
			</div>
		</section>
		<ActionPanel page="primaria" lang={lang} />
	</main>
	<Footer lang={lang} />
</Layout>

<style>
	.level-page {
		background: white;
	}

	.hero-section {
		background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
		color: white;
		padding: 4rem 0;
		text-align: center;
	}

	.hero-section h1 {
		font-size: 3rem;
		margin: 0 0 1rem 0;
		font-weight: 800;
	}

	.hero-section p {
		font-size: 1.2rem;
		margin: 0;
	}

	.curriculum {
		padding: 4rem 0;
	}

	.curriculum h2,
	.programs h2 {
		text-align: center;
		font-size: 2rem;
		color: var(--color-primary);
		margin-bottom: 2rem;
		font-weight: 800;
	}

	.curriculum-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	.curriculum-grid h3 {
		color: var(--color-accent);
		margin-bottom: 1rem;
		font-size: 1.3rem;
	}

	.curriculum-grid ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.curriculum-grid li {
		padding: 0.5rem 0;
		border-bottom: 1px solid #eee;
		color: var(--color-text);
	}

	.programs {
		padding: 4rem 0;
		background: var(--color-bg-alt);
	}

	.programs-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}

	.programs-grid article {
		background: white;
		padding: 1.5rem;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.programs-grid h3 {
		color: var(--color-primary);
		margin-top: 0;
	}

	@media (max-width: 768px) {
		.curriculum-grid {
			grid-template-columns: 1fr;
		}

		.hero-section h1 {
			font-size: 2rem;
		}
	}
</style>
