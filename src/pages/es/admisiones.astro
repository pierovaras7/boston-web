---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import SiteHero from "../../components/SiteHero.astro";
import AdmissionsBody from "../../components/AdmissionsBody.astro";

const lang = "es";
---

<Layout title="Admisiones 2027 - Boston Bilingual School" lang={lang}>
  <main class="admissions-page">
    <SiteHero page="admisiones" lang={lang} />
    <AdmissionsBody lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .admissions-page{overflow-x:clip;background:#fff}
</style>
