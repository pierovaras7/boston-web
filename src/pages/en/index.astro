---
import Layout from "../../layouts/Layout.astro";
import HeroVideo from "../../components/HeroVideo.astro";
import Pillars from "../../components/Pillars.astro";
import LevelAccess from "../../components/LevelAccess.astro";
import Testimonials from "../../components/Testimonials.astro";
import BlogHighlights from "../../components/BlogHighlights.astro";
import Footer from "../../components/Footer.astro";

const lang = "en";
---

<Layout title="Boston Bilingual School | Quality Education" lang={lang}>
	<main>
		<HeroVideo lang={lang} />
		<Pillars lang={lang} />
		<LevelAccess lang={lang} />
		<Testimonials lang={lang} />
		<BlogHighlights lang={lang} />
	</main>
	<Footer lang={lang} />
</Layout>
