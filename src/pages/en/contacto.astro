---
import Layout from "../../layouts/Layout.astro";
import { getTranslation } from "../../i18n/translations";
import Footer from "../../components/Footer.astro";
import ContactFormSimple from "../../components/ContactFormSimple.astro";

const lang = "en";
const t = getTranslation(lang);
---

<Layout title="Contact - Boston Bilingual School" lang={lang}>
	<main class="contact-page">
		<section class="hero-section">
			<div class="container">
				<h1>Contact Us</h1>
				<p>We're here to answer your questions</p>
			</div>
		</section>


		<section class="form-section">
			<div class="container">
				<ContactFormSimple lang="en" />
			</div>
		</section>

		<section class="hours-section">
			<div class="container">
				<h2>Business Hours</h2>
				<div class="hours-grid">
					<div class="hours-card">
						<h3>Monday - Friday</h3>
						<p>8:00 AM - 5:00 PM</p>
					</div>
					<div class="hours-card">
						<h3>Saturday</h3>
						<p>9:00 AM - 1:00 PM</p>
					</div>
					<div class="hours-card">
						<h3>Sunday</h3>
						<p>Closed</p>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer lang={lang} />
</Layout>

<style>
	.contact-page {
		background: white;
	}

	.hero-section {
		background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
		color: white;
		padding: 4rem 0;
		text-align: center;
	}

	.hero-section h1 {
		font-size: 3rem;
		margin: 0 0 1rem 0;
		font-weight: 800;
	}

	.hero-section p {
		font-size: 1.2rem;
		margin: 0;
	}

	.contact-info-section {
		padding: 4rem 0;
	}

	.info-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}

	.info-card {
		background: var(--color-bg-alt);
		padding: 2rem;
		border-radius: 8px;
		text-align: center;
		border-top: 3px solid var(--color-accent);
	}

	.info-icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.info-card h3 {
		color: var(--color-primary);
		margin: 1rem 0 0.5rem 0;
		font-size: 1.2rem;
	}

	.info-card p {
		color: var(--color-text);
		margin: 0;
		line-height: 1.6;
	}

	.info-card a {
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 600;
		transition: color 0.3s ease;
	}

	.info-card a:hover {
		color: var(--color-primary);
		text-decoration: underline;
	}

	.form-section {
		padding: 4rem 0;
		background: var(--color-bg-alt);
	}

	.hours-section {
		padding: 4rem 0;
	}

	.hours-section h2 {
		text-align: center;
		font-size: 2rem;
		color: var(--color-primary);
		margin-bottom: 2rem;
		font-weight: 800;
	}

	.hours-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 2rem;
	}

	.hours-card {
		background: white;
		padding: 2rem;
		border-radius: 8px;
		text-align: center;
		border-left: 4px solid var(--color-accent);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.hours-card h3 {
		color: var(--color-primary);
		margin: 0 0 0.5rem 0;
	}

	.hours-card p {
		color: var(--color-text);
		margin: 0;
		font-size: 1rem;
	}

	@media (max-width: 768px) {
		.hero-section h1 {
			font-size: 2rem;
		}

		.info-grid {
			grid-template-columns: 1fr;
		}

		.hours-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
