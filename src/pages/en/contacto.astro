---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import SiteHero from "../../components/SiteHero.astro";
import ContactBody from "../../components/ContactBody.astro";

const lang = "en";
---

<Layout title="Contact - Boston Bilingual School" lang={lang}>
  <main class="contact-page">
    <SiteHero page="contacto" lang={lang} />
    <ContactBody lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .contact-page{overflow-x:clip;background:#fff}
</style>
