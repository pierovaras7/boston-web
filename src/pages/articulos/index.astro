---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const lang = 'es';

// Obtener todos los artículos
const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const translations = {
  es: {
    title: 'Blog de Noticias',
    subtitle: 'Artículos, eventos y logros académicos',
    readMore: 'Leer más',
    categoria: 'Categoría',
    fecha: 'Fecha',
    noArticles: 'No hay artículos disponibles.',
  },
};

const t = translations.es;

const categoryColors: Record<string, string> = {
  académico: 'bg-blue-100 text-blue-800',
  concurso: 'bg-green-100 text-green-800',
  evento: 'bg-purple-100 text-purple-800',
  educativo: 'bg-yellow-100 text-yellow-800',
};

const categoryLabels: Record<string, string> = {
  académico: 'Académico',
  concurso: 'Concurso',
  evento: 'Evento',
  educativo: 'Educativo',
};
---

<Layout title="Blog de Noticias | Boston Preuniversitario" lang={lang}>
  <main>
    {/* Header */}
    <section class="py-12 px-4 sm:px-6 lg:px-8 bg-gradient-to-r from-blue-600 to-teal-600">
      <div class="max-w-4xl mx-auto text-center text-white">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{t.title}</h1>
        <p class="text-lg text-blue-100">{t.subtitle}</p>
      </div>
    </section>

    {/* Articles List */}
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        {sortedArticles.length > 0 ? (
          <div class="space-y-8">
            {sortedArticles.map((article) => (
              <article class="group bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-gray-200">
                <div class="flex flex-col md:flex-row">
                  {/* Image */}
                  {article.data.image && (
                    <div class="md:w-1/3 h-48 md:h-auto overflow-hidden bg-gray-200">
                      <img
                        src={article.data.image}
                        alt={article.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    </div>
                  )}

                  {/* Content */}
                  <div class="p-6 md:w-2/3 flex flex-col justify-between">
                    {/* Category Badge */}
                    <div class="mb-3">
                      <span
                        class={`inline-block px-3 py-1 rounded-full text-sm font-semibold ${categoryColors[article.data.category]}`}
                      >
                        {categoryLabels[article.data.category]}
                      </span>
                    </div>

                    {/* Title */}
                    <h2 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">
                      {article.data.title}
                    </h2>

                    {/* Description */}
                    <p class="text-gray-600 mb-4">
                      {article.data.description}
                    </p>

                    {/* Meta and Link */}
                    <div class="flex items-center justify-between">
                      <time datetime={article.data.date.toISOString()} class="text-sm text-gray-500">
                        {new Date(article.data.date).toLocaleDateString('es-ES', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </time>
                      <a
                        href={`/articulos/${article.slug}`}
                        class="inline-flex items-center text-blue-600 font-semibold hover:text-blue-800 transition-colors"
                      >
                        {t.readMore}
                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <p class="text-gray-600 text-lg">{t.noArticles}</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
