---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: any;
}

const { article } = Astro.props as Props;
const { Content } = await render(article);

const lang = 'es';

const categoryLabels: Record<string, string> = {
  académico: 'Académico',
  concurso: 'Concurso',
  evento: 'Evento',
  educativo: 'Educativo',
};

const categoryColors: Record<string, string> = {
  académico: 'bg-blue-100 text-blue-800',
  concurso: 'bg-green-100 text-green-800',
  evento: 'bg-purple-100 text-purple-800',
  educativo: 'bg-yellow-100 text-yellow-800',
};

const breadcrumbText = lang === 'es' ? 'Volver a Noticias' : 'Back to News';
---

<Layout title={article.data.title} lang={lang}>
  <main>
    {/* Breadcrumb */}
    <div class="px-4 sm:px-6 lg:px-8 py-4 bg-gray-100">
      <div class="max-w-4xl mx-auto">
        <a href="/articulos" class="text-blue-600 hover:text-blue-800 font-semibold flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {breadcrumbText}
        </a>
      </div>
    </div>

    {/* Article Header */}
    <section class="py-12 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-gray-50 to-white">
      <div class="max-w-4xl mx-auto">
        {/* Category Badge */}
        <div class="mb-4">
          <span
            class={`inline-block px-4 py-2 rounded-full text-sm font-semibold ${categoryColors[article.data.category]}`}
          >
            {categoryLabels[article.data.category]}
          </span>
        </div>

        {/* Title */}
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          {article.data.title}
        </h1>

        {/* Meta */}
        <div class="flex flex-col md:flex-row md:items-center md:justify-between text-gray-600 mb-8">
          <div class="flex items-center space-x-4 mb-4 md:mb-0">
            <time datetime={article.data.date.toISOString()}>
              {new Date(article.data.date).toLocaleDateString('es-ES', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            {article.data.author && <span class="text-gray-500">•</span>}
            {article.data.author && <span>{article.data.author}</span>}
          </div>
        </div>

        {/* Featured Image */}
        {article.data.image && (
          <div class="mb-8">
            <img
              src={article.data.image}
              alt={article.data.title}
              class="w-full h-96 object-cover rounded-lg shadow-lg"
            />
          </div>
        )}
      </div>
    </section>

    {/* Article Content */}
    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <article class="prose prose-lg max-w-none">
          <Content />
        </article>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style is:global>
  .prose {
    color: #374151;
  }

  .prose h2 {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    color: #111827;
    margin: 2rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
  }

  .prose h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 700;
    color: #111827;
    margin: 1.5rem 0 .75rem;
  }

  .prose p {
    margin-bottom: 1rem;
    line-height: 1.625;
  }

  .prose ul,
  .prose ol {
    margin: 0 0 1rem 1.5rem;
  }

  .prose li {
    margin-bottom: .5rem;
  }

  .prose strong {
    font-weight: 700;
    color: #111827;
  }

  .prose em {
    font-style: italic;
    color: #374151;
  }
</style>
