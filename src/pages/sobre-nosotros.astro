---
import Layout from "../layouts/Layout.astro";
import { getTranslation } from "../i18n/translations";
import Footer from "../components/Footer.astro";

// Detectar idioma desde query param o default a "es"
const langParam = Astro.url.searchParams.get("lang");
const lang = (langParam === "en" || langParam === "es") ? langParam : "es";
const t = getTranslation(lang);
---

<Layout title="Sobre Nosotros - Boston Bilingual School" lang={lang}>
	<main class="about-page">
		<section class="hero-section">
			<div class="container">
				<h1>Sobre Boston Bilingual School</h1>
				<p>Educación de calidad con visión de ciudadanía global desde 1990</p>
			</div>
		</section>

		<section class="content-section">
			<div class="container">
				<h2>Nuestra Historia y Propósito</h2>
				<p>Boston Bilingual School es una institución educativa privada bilingüe preuniversitaria ubicada en una de las mejores zonas de Trujillo. Su infraestructura está diseñada cumpliendo con las Condiciones Básicas de Calidad estipuladas por el Ministerio de Educación (MINEDU).</p>

				<p>Es un colegio inclusivo, no confesional y respetuoso de todas las creencias, que declara una postura neutral en asuntos de fe. Su identidad se define por una <strong>Visión de Ciudadanía Global</strong>: un modelo educativo interdisciplinario que integra los Temas Centrales de la UNESCO y los Objetivos de Desarrollo Sostenible (ODS), orientando el aprendizaje hacia la resolución de problemas del mundo real.</p>
			</div>
		</section>

		<section class="vision-mission">
			<div class="container">
				<div class="vm-card">
					<h3>Misión</h3>
					<p>"Somos una Institución Educativa Privada que atiende los niveles de Primaria y Secundaria de Educación Básica Regular. Desarrollamos competencias centradas en los enfoques transversales del Currículo Nacional, formando estudiantes listos para ser ciudadanos globales a través de una educación con estándares nacionales e internacionales, preparándolos para ingresar a las universidades más destacadas del Perú y del mundo."</p>
				</div>

				<div class="vm-card">
					<h3>Visión</h3>
					<p>"Para el 2030, Boston Bilingual School será reconocido como el colegio líder en Trujillo, distinguido por formar ciudadanos globales con dominio y certificación internacional en inglés y francés, y por preparar para el ingreso a destacadas universidades nacionales e internacionales."</p>
				</div>
			</div>
		</section>

		<section class="philosophy">
			<div class="container">
				<h2>Filosofía Institucional y Modelo Pedagógico</h2>

				<div class="philosophy-grid">
					<div class="phil-card">
						<h3>📚 Excelencia Lingüística</h3>
						<p>Enseñanza avanzada de inglés y francés bajo estándares internacionales con enfoque en certificación global.</p>
					</div>

					<div class="phil-card">
						<h3>🎓 Formación Preuniversitaria</h3>
						<p>Preparación rigurosa para exámenes de admisión a universidades nacionales e internacionales de prestigio.</p>
					</div>

					<div class="phil-card">
						<h3>🏆 Competitividad y Talento</h3>
						<p>Participación activa en concursos y olimpiadas nacionales e internacionales para desarrollar competencias.</p>
					</div>

					<div class="phil-card">
						<h3>🌱 Desarrollo Integral</h3>
						<p>Fortalecimiento de las áreas cognoscitiva, afectiva y psicomotora de cada estudiante de manera holística.</p>
					</div>

					<div class="phil-card">
						<h3>🌍 Ciudadanía Global</h3>
						<p>Integración de temas UNESCO y ODS para formar ciudadanos responsables del mundo.</p>
					</div>

					<div class="phil-card">
						<h3>⚖️ Valores Fundamentales</h3>
						<p>Lealtad, Respeto, Responsabilidad, Integridad, Honestidad, Excelencia, Perseverancia y más.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="values">
			<div class="container">
				<h2>Línea Axiológica Institucional</h2>

				<div class="values-list">
					<div>
						<h4>Pilar 1: Lealtad y Confianza</h4>
						<p>Fomentamos la honestidad y la fidelidad a nuestros principios institucionales.</p>
					</div>

					<div>
						<h4>Pilar 2: Respeto y Tolerancia</h4>
						<p>Valoramos la diversidad y creemos en el respeto mutuo entre todos los miembros de la comunidad.</p>
					</div>

					<div>
						<h4>Pilar 3: Responsabilidad</h4>
						<p>Asumimos compromisos con nosotros mismos, nuestra comunidad y nuestro planeta.</p>
					</div>

					<div>
						<h4>Pilar 4: Excelencia Académica</h4>
						<p>Buscamos siempre la más alta calidad en nuestros procesos educativos.</p>
					</div>

					<div>
						<h4>Pilar 5: Solidaridad y Empatía</h4>
						<p>Nos preocupamos por el bienestar de los demás y trabajamos juntos por el bien común.</p>
					</div>

					<div>
						<h4>Pilar 6: Apertura e Innovación</h4>
						<p>Estamos siempre abiertos a nuevas ideas y formas de mejorar nuestro trabajo educativo.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="cta-section">
			<div class="container">
				<h2>Conoce Boston Bilingual School</h2>
				<p>Agenda una visita y descubre por qué somos la mejor opción educativa de Trujillo.</p>
				<a href="/contacto" class="cta-button">Agendar Visita</a>
			</div>
		</section>
	</main>
	<Footer lang={lang} />
</Layout>

<style>
	.about-page {
		background: white;
	}

	/* Hero Section */
	.hero-section {
		background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
		color: white;
		padding: 6rem 0;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.hero-section::before {
		content: '';
		position: absolute;
		top: -50%;
		right: -10%;
		width: 500px;
		height: 500px;
		background: rgba(255, 255, 255, 0.05);
		border-radius: 50%;
		pointer-events: none;
	}

	.hero-section .container {
		position: relative;
		z-index: 1;
	}

	.hero-section h1 {
		font-size: 3.5rem;
		margin: 0 0 1rem 0;
		font-weight: 900;
		letter-spacing: -1px;
		line-height: 1.2;
	}

	.hero-section p {
		font-size: 1.3rem;
		margin: 0;
		opacity: 0.95;
		font-weight: 300;
	}

	/* Content Section */
	.content-section {
		padding: 5rem 0;
	}

	.content-section h2 {
		color: var(--color-primary);
		font-size: 2.5rem;
		margin-bottom: 2rem;
		font-weight: 800;
		position: relative;
		padding-bottom: 1rem;
	}

	.content-section h2::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 60px;
		height: 4px;
		background: var(--color-accent);
		border-radius: 2px;
	}

	.content-section p {
		color: var(--color-text);
		line-height: 1.9;
		margin-bottom: 1.5rem;
		font-size: 1.1rem;
	}

	.content-section strong {
		color: var(--color-primary);
		font-weight: 700;
	}

	/* Vision & Mission */
	.vision-mission {
		padding: 5rem 0;
		background: linear-gradient(to bottom, #f5f5f5, white);
	}

	.vision-mission .container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
	}

	.vm-card {
		background: white;
		padding: 2.5rem;
		border-radius: 12px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
		border-top: 4px solid var(--color-accent);
		transition: all 0.3s ease;
		position: relative;
	}

	.vm-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 0;
		background: rgba(255, 153, 0, 0.05);
		border-radius: 12px 12px 0 0;
		transition: height 0.3s ease;
	}

	.vm-card:hover {
		transform: translateY(-8px);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
	}

	.vm-card h3 {
		color: var(--color-primary);
		font-size: 1.8rem;
		margin: 0 0 1.5rem 0;
		font-weight: 800;
	}

	.vm-card p {
		color: var(--color-text);
		line-height: 1.8;
		margin: 0;
		font-size: 1rem;
	}

	/* Philosophy */
	.philosophy {
		padding: 5rem 0;
		background: white;
	}

	.philosophy h2 {
		text-align: center;
		color: var(--color-primary);
		font-size: 2.5rem;
		margin-bottom: 3rem;
		font-weight: 800;
		position: relative;
		padding-bottom: 1.5rem;
	}

	.philosophy h2::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 4px;
		background: var(--color-accent);
		border-radius: 2px;
	}

	.philosophy-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2.5rem;
	}

	.phil-card {
		background: linear-gradient(135deg, #f5f5f5 0%, white 100%);
		padding: 2rem;
		border-radius: 12px;
		text-align: center;
		border: 1px solid rgba(0, 0, 0, 0.05);
		transition: all 0.3s ease;
	}

	.phil-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 8px 20px rgba(0, 61, 130, 0.1);
		background: linear-gradient(135deg, white 0%, #f5f5f5 100%);
	}

	.phil-card h3 {
		color: var(--color-primary);
		margin: 0 0 1rem 0;
		font-size: 1.3rem;
		font-weight: 700;
	}

	.phil-card p {
		color: var(--color-text);
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* Values Section */
	.values {
		padding: 5rem 0;
		background: linear-gradient(to bottom, #f5f5f5, white);
	}

	.values h2 {
		text-align: center;
		color: var(--color-primary);
		font-size: 2.5rem;
		margin-bottom: 3rem;
		font-weight: 800;
		position: relative;
		padding-bottom: 1.5rem;
	}

	.values h2::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 4px;
		background: var(--color-accent);
		border-radius: 2px;
	}

	.values-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2.5rem;
	}

	.values-list div {
		background: white;
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
		border-left: 4px solid var(--color-accent);
		transition: all 0.3s ease;
	}

	.values-list div:hover {
		transform: translateX(8px);
		box-shadow: 0 8px 25px rgba(255, 153, 0, 0.15);
	}

	.values-list h4 {
		color: var(--color-primary);
		margin: 0 0 0.75rem 0;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.values-list p {
		color: var(--color-text);
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* CTA Section */
	.cta-section {
		padding: 5rem 0;
		text-align: center;
		background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
		color: white;
		position: relative;
		overflow: hidden;
	}

	.cta-section::before {
		content: '';
		position: absolute;
		bottom: -50%;
		left: -10%;
		width: 500px;
		height: 500px;
		background: rgba(255, 255, 255, 0.05);
		border-radius: 50%;
		pointer-events: none;
	}

	.cta-section .container {
		position: relative;
		z-index: 1;
	}

	.cta-section h2 {
		font-size: 2.5rem;
		margin: 0 0 1rem 0;
		font-weight: 800;
	}

	.cta-section p {
		font-size: 1.2rem;
		margin-bottom: 2rem;
		opacity: 0.95;
	}

	.cta-button {
		display: inline-block;
		background: white;
		color: var(--color-primary);
		padding: 1.2rem 2.5rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 700;
		transition: all 0.3s ease;
		font-size: 1.1rem;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
	}

	.cta-button:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
		background: var(--color-accent);
		color: white;
	}

	@media (max-width: 1024px) {
		.vision-mission .container {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.hero-section h1 {
			font-size: 2.5rem;
		}

		.content-section h2,
		.philosophy h2,
		.values h2 {
			font-size: 2rem;
		}

		.cta-section h2 {
			font-size: 2rem;
		}

		.cta-button {
			padding: 1rem 2rem;
			font-size: 1rem;
		}
	}
</style>
