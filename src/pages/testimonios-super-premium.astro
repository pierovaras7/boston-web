---
import { Image } from "astro:assets";
import testimonio1 from "../assets/images/home/testimonios/testimonio_1.png";
import testimonio2 from "../assets/images/home/testimonios/testimonio_2.png";
import testimonio3 from "../assets/images/home/testimonios/testimonio_3.png";
import testimonio4 from "../assets/images/home/testimonios/testimonio_4.png";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Testimonios Super Premium</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #f5f5f5;
      padding: 3rem 2rem;
    }

    h1 {
      text-align: center;
      color: #003d82;
      margin-bottom: 3rem;
      font-size: 2.5rem;
    }

    .section-container {
      max-width: 1200px;
      margin: 0 auto 4rem;
      padding: 3rem;
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 61, 130, 0.1);
    }

    .section-title {
      text-align: center;
      color: #003d82;
      font-size: 2.8rem;
      margin-bottom: 1rem;
      font-weight: 900;
    }

    .section-subtitle {
      text-align: center;
      color: #666;
      font-size: 1.1rem;
      margin-bottom: 3rem;
    }

    /* VERSIÓN 1: PREMIUM ELEGANTE */
    .carousel-premium-1 {
      position: relative;
      height: 550px;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 61, 130, 0.2);
      background: white;
    }

    .slide-1 {
      position: absolute;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .slide-1.active {
      opacity: 1;
    }

    .slide-1 img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .overlay-1 {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.85) 50%, rgba(0, 0, 0, 0.95) 100%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 5rem 4rem;
      color: white;
    }

    .quote-mark {
      font-size: 4rem;
      color: var(--color-accent);
      margin-bottom: 1rem;
      opacity: 0.8;
    }

    .text-1 {
      font-size: 1.5rem;
      line-height: 1.8;
      margin-bottom: 2.5rem;
      font-weight: 500;
      max-width: 700px;
    }

    .author-section-1 {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .author-name-1 {
      font-size: 1.3rem;
      font-weight: 800;
      margin-bottom: 0.3rem;
    }

    .author-role-1 {
      font-size: 1rem;
      opacity: 0.9;
      font-weight: 500;
    }

    .divider-1 {
      width: 3px;
      height: 40px;
      background: var(--color-accent);
      margin-left: 0.5rem;
    }

    /* Controls Premium 1 */
    .controls-1 {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 80px;
      background: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.3) 100%);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 3rem;
      z-index: 10;
    }

    .arrows-1 {
      display: flex;
      gap: 1.5rem;
    }

    .arrow-1 {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.95);
      border: 2px solid transparent;
      font-size: 1.5rem;
      color: #003d82;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

    .arrow-1:hover {
      background: var(--color-accent);
      color: white;
      transform: scale(1.15);
      border-color: var(--color-accent);
    }

    .dots-1 {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .dot-1 {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.6);
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      border: 2px solid transparent;
    }

    .dot-1:hover {
      background: rgba(255, 255, 255, 0.9);
      transform: scale(1.3);
    }

    .dot-1.active {
      background: var(--color-accent);
      width: 36px;
      border-radius: 6px;
    }

    /* VERSIÓN 2: MINIMAL LUXURY */
    .carousel-premium-2 {
      position: relative;
      height: 520px;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 24px 72px rgba(0, 61, 130, 0.25);
    }

    .slide-2 {
      position: absolute;
      width: 100%;
      height: 100%;
      opacity: 0;
      transform: scale(1.02);
      transition: all 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .slide-2.active {
      opacity: 1;
      transform: scale(1);
    }

    .slide-2 img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .overlay-2 {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 30%, transparent 70%);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 4rem 4rem 3rem;
    }

    .star-rating {
      align-self: flex-start;
      font-size: 1.8rem;
      color: var(--color-accent);
      letter-spacing: 0.3rem;
    }

    .content-2 {
      color: white;
    }

    .text-2 {
      font-size: 1.4rem;
      line-height: 1.9;
      margin-bottom: 2rem;
      font-weight: 400;
      max-width: 650px;
    }

    .footer-2 {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .author-info-2 {
      color: white;
    }

    .author-name-2 {
      font-size: 1.2rem;
      font-weight: 800;
      margin-bottom: 0.4rem;
    }

    .author-role-2 {
      font-size: 0.95rem;
      opacity: 0.85;
    }

    .counter-2 {
      font-size: 0.95rem;
      opacity: 0.7;
      font-weight: 600;
      letter-spacing: 0.1rem;
    }

    .dots-bar-2 {
      display: flex;
      gap: 0.6rem;
      align-items: center;
    }

    .dot-bar-2 {
      height: 4px;
      background: rgba(255, 255, 255, 0.4);
      cursor: pointer;
      transition: all 0.4s ease;
      border-radius: 2px;
    }

    .dot-bar-2:hover {
      background: rgba(255, 255, 255, 0.7);
    }

    .dot-bar-2.active {
      background: var(--color-accent);
      width: 40px;
    }

    .dot-bar-2:not(.active) {
      width: 20px;
    }

    /* VERSIÓN 3: ULTRA MODERN */
    .carousel-premium-3 {
      position: relative;
      height: 550px;
      border-radius: 28px;
      overflow: hidden;
      background: linear-gradient(135deg, #f5f7fa 0%, #e8eef5 100%);
      box-shadow: 0 20px 60px rgba(0, 61, 130, 0.2);
    }

    .slide-3 {
      position: absolute;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 1s ease-out;
    }

    .slide-3.active {
      opacity: 1;
    }

    .slide-3 img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .overlay-3 {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(0,61,130,0.1) 0%, rgba(0,61,130,0.85) 100%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 5rem 4rem;
      color: white;
    }

    .text-3 {
      font-size: 1.5rem;
      line-height: 1.85;
      margin-bottom: 3rem;
      font-weight: 500;
      max-width: 750px;
    }

    .author-section-3 {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .author-info-3 {
      flex: 1;
    }

    .author-name-3 {
      font-size: 1.3rem;
      font-weight: 800;
      margin-bottom: 0.4rem;
      letter-spacing: -0.5px;
    }

    .author-role-3 {
      font-size: 1rem;
      opacity: 0.9;
      font-weight: 500;
    }

    .progress-3 {
      display: flex;
      gap: 1.2rem;
      align-items: center;
    }

    .progress-bar-3 {
      width: 120px;
      height: 6px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 3px;
      overflow: hidden;
    }

    .progress-fill-3 {
      height: 100%;
      background: linear-gradient(90deg, var(--color-accent) 0%, #ff7c00 100%);
      width: 25%;
      transition: width 8s linear;
      border-radius: 3px;
    }

    .progress-text-3 {
      font-size: 0.9rem;
      opacity: 0.8;
      min-width: 35px;
    }

    @media (max-width: 900px) {
      .carousel-premium-1, .carousel-premium-2, .carousel-premium-3 {
        height: 400px;
      }

      .overlay-1, .overlay-2, .overlay-3 {
        padding: 3rem 2rem;
      }

      .text-1, .text-2, .text-3 {
        font-size: 1.2rem;
      }

      .controls-1 {
        padding: 0 1.5rem;
      }
    }

    .desc-box {
      background: #f9f9f9;
      padding: 1.5rem;
      border-radius: 8px;
      margin-top: 1rem;
      border-left: 4px solid #ff9900;
      font-size: 0.9rem;
    }

    :root {
      --color-accent: #ff9900;
    }
  </style>
</head>
<body>
  <h1>🌟 Testimonios Super Premium</h1>

  <!-- VERSIÓN 1 -->
  <div class="section-container">
    <h2 class="section-title">Versión 1: Premium Elegante</h2>
    <p class="section-subtitle">Flechas grandes + Dots elegantes + Comillas destacadas</p>

    <div class="carousel-premium-1">
      <div class="slide-1 active">
        <img src={testimonio1.src} alt="Testimonio">
      </div>
      <div class="slide-1">
        <img src={testimonio2.src} alt="Testimonio">
      </div>
      <div class="slide-1">
        <img src={testimonio3.src} alt="Testimonio">
      </div>
      <div class="slide-1">
        <img src={testimonio4.src} alt="Testimonio">
      </div>

      <div class="overlay-1">
        <div class="quote-mark">❝</div>
        <p class="text-1">Boston Bilingual School ha transformado la vida de nuestro hijo. Su dominio del inglés y su confianza en el aula han crecido enormemente.</p>
        <div class="author-section-1">
          <div>
            <div class="author-name-1">Familia García</div>
            <div class="author-role-1">Padres de estudiante</div>
          </div>
          <div class="divider-1"></div>
        </div>
      </div>

      <div class="controls-1">
        <div class="arrows-1">
          <button class="arrow-1 prev">←</button>
          <button class="arrow-1 next">→</button>
        </div>
        <div class="dots-1">
          <div class="dot-1 active"></div>
          <div class="dot-1"></div>
          <div class="dot-1"></div>
          <div class="dot-1"></div>
        </div>
      </div>
    </div>

    <div class="desc-box">
      <strong>Versión 1:</strong> Comillas grandes, texto 1.5rem, flechas premium con divider, dots elegantes.
    </div>
  </div>

  <!-- VERSIÓN 2 -->
  <div class="section-container">
    <h2 class="section-title">Versión 2: Minimal Luxury</h2>
    <p class="section-subtitle">Estrellas + Contador + Barra de progreso horizontal</p>

    <div class="carousel-premium-2">
      <div class="slide-2 active">
        <img src={testimonio1.src} alt="Testimonio">
      </div>
      <div class="slide-2">
        <img src={testimonio2.src} alt="Testimonio">
      </div>
      <div class="slide-2">
        <img src={testimonio3.src} alt="Testimonio">
      </div>
      <div class="slide-2">
        <img src={testimonio4.src} alt="Testimonio">
      </div>

      <div class="overlay-2">
        <div class="star-rating">★★★★★</div>
        <div class="content-2">
          <p class="text-2">Boston Bilingual School ha transformado la vida de nuestro hijo. Su dominio del inglés y su confianza han crecido enormemente.</p>
          <div class="footer-2">
            <div class="author-info-2">
              <div class="author-name-2">Familia García</div>
              <div class="author-role-2">Padres de estudiante</div>
            </div>
            <div class="dots-bar-2">
              <div class="dot-bar-2 active"></div>
              <div class="dot-bar-2"></div>
              <div class="dot-bar-2"></div>
              <div class="dot-bar-2"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="desc-box">
      <strong>Versión 2:</strong> Rating de estrellas, barra de progreso horizontal, escala elegante, animación suave.
    </div>
  </div>

  <!-- VERSIÓN 3 -->
  <div class="section-container">
    <h2 class="section-title">Versión 3: Ultra Modern</h2>
    <p class="section-subtitle">Gradiente azul + Barra de progreso lineal + Contador</p>

    <div class="carousel-premium-3">
      <div class="slide-3 active">
        <img src={testimonio1.src} alt="Testimonio">
      </div>
      <div class="slide-3">
        <img src={testimonio2.src} alt="Testimonio">
      </div>
      <div class="slide-3">
        <img src={testimonio3.src} alt="Testimonio">
      </div>
      <div class="slide-3">
        <img src={testimonio4.src} alt="Testimonio">
      </div>

      <div class="overlay-3">
        <p class="text-3">Boston Bilingual School ha transformado la vida de nuestro hijo. Su dominio del inglés y su confianza en el aula han crecido enormemente.</p>
        <div class="author-section-3">
          <div class="author-info-3">
            <div class="author-name-3">Familia García</div>
            <div class="author-role-3">Padres de estudiante</div>
          </div>
          <div class="progress-3">
            <div class="progress-bar-3">
              <div class="progress-fill-3"></div>
            </div>
            <div class="progress-text-3">1/4</div>
          </div>
        </div>
      </div>
    </div>

    <div class="desc-box">
      <strong>Versión 3:</strong> Gradiente azul overlay, barra de progreso lineal con contador, animación 8s.
    </div>
  </div>

  <script>
    // Versión 1
    const slides1 = document.querySelectorAll('.carousel-premium-1 .slide-1');
    const dots1 = document.querySelectorAll('.carousel-premium-1 .dot-1');
    let current1 = 0;

    document.querySelector('.carousel-premium-1 .arrow-1.prev').addEventListener('click', () => {
      slides1[current1].classList.remove('active');
      dots1[current1].classList.remove('active');
      current1 = (current1 - 1 + slides1.length) % slides1.length;
      slides1[current1].classList.add('active');
      dots1[current1].classList.add('active');
    });

    document.querySelector('.carousel-premium-1 .arrow-1.next').addEventListener('click', () => {
      slides1[current1].classList.remove('active');
      dots1[current1].classList.remove('active');
      current1 = (current1 + 1) % slides1.length;
      slides1[current1].classList.add('active');
      dots1[current1].classList.add('active');
    });

    setInterval(() => {
      slides1[current1].classList.remove('active');
      dots1[current1].classList.remove('active');
      current1 = (current1 + 1) % slides1.length;
      slides1[current1].classList.add('active');
      dots1[current1].classList.add('active');
    }, 8000);
  </script>
</body>
</html>
