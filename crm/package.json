{
  "name": "boston-crm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test worker/index.test.ts",
    "typecheck": "wrangler types && tsc --noEmit",
    "build": "npm run typecheck && vite build && wrangler deploy --dry-run --outdir dist-worker",
