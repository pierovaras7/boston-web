{
  "name": "boston-crm",
  "main": "worker/main.ts",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "boston-web-db",
    "database_id": "50d20d93-7b59-4bd0-8d06-448fd5f61673"
  }],
  "durable_objects": { "bindings": [
    { "name": "REALTIME_HUB", "class_name": "CrmRealtimeHub" }
  ] },
  "migrations": [
    { "tag": "v1-realtime", "new_sqlite_classes": ["CrmRealtimeHub"] }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://young-feather-6ed6.cloudflareaccess.com",
    "POLICY_AUD": "2fccb92fb3f2ebbb69b8ac81afa7a64931b95911c00dbd668326e5eb71386716"
  }
}
