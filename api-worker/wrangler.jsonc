{
  "name": "boston-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "boston-web-db",
    "database_id": "50d20d93-7b59-4bd0-8d06-448fd5f61673",
    "migrations_dir": "migrations"
  }],
  "services": [{
    "binding": "CRM_EVENTS",
    "service": "boston-crm",
    "entrypoint": "CrmEventsService"
  }],
  "vars": {
    "ORIGENES_PERMITIDOS": "https://boston-web.cueva-dev.workers.dev",
    "TURNSTILE_HOSTNAMES": "boston-web.cueva-dev.workers.dev"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"]
  }
}
